# Required when the database foundation is enabled.
DATABASE_URL=postgresql://habitat_app:replace_me@localhost:5432/habitat?schema=public
# Required by docker-compose.yml for the postgres container. Must match the
# password embedded in DATABASE_URL above.
POSTGRES_PASSWORD=replace_me

# Canonical public origin for Auth.js and every external callback/redirect.
# Production callback and redirect handling rejects a missing, non-HTTPS, or path-bearing value.
# Never commit the real authentication values below.
AUTH_URL=https://habitat.martinobear.com
AUTH_SECRET=replace_with_a_long_random_value
AUTH_TRUST_HOST=true
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
BOOTSTRAP_ADMIN_EMAIL=

# Server-side private integration settings. Leave an optional integration blank
# until it is configured and locally verified; never commit real values.
HABITAT_AGENT_TOKEN=
HABITAT_AGENT_URL=
HABITAT_WORKER_POLL_INTERVAL_MS=15000
HABITAT_WORKER_HISTORY_SCAN_INTERVAL_MS=21600000
HABITAT_WORKER_PROVIDER_SCAN_INTERVAL_MS=300000
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Optional unofficial Marvel Rivals stats provider. Kept server-side and used
# only for member-requested profile linking and bounded worker refreshes.
MARVEL_RIVALS_API_KEY=
# Provider selection: "marvelrivalsapi" (needs the key above), "rivalsmeta"
# (community fallback scraped politely from rivalsmeta.com's public site API),
# or "off". When blank, the official API is used if its key is set, otherwise
# the rivalsmeta fallback keeps member stats flowing.
MARVEL_RIVALS_PROVIDER=
# Profile/match refresh cadence in minutes (15-1440). Defaults: 60 for
# rivalsmeta, 360 for the official API.
MARVEL_RIVALS_REFRESH_MINUTES=
# Optional official Steam Web API key. Used only by the worker for members who
# explicitly enable Steam enrichment after verifying their Steam account.
STEAM_WEB_API_KEY=
# Country or countries where cached Steam data is stored, displayed in the
# privacy notice and required before the worker will retrieve Steam data.
STEAM_DATA_STORAGE_COUNTRY=
STEAM_WEB_API_DAILY_REQUEST_BUDGET=5000
# Daily request cap for the active Rivals provider (defaults: 2500 official,
# 1000 rivalsmeta to stay a polite guest on the community site).
MARVEL_RIVALS_DAILY_REQUEST_BUDGET=2500
# Keep activity-backed achievements/records disabled until a provider-backed
# shadow evaluation has been reviewed, then set true and rerun the seed.
HABITAT_CROSS_GAME_CONSUMERS_ENABLED=false
# The Cloudflare tunnel is managed outside this repo; no compose service or
# script here consumes this value.
CLOUDFLARE_TUNNEL_TOKEN=

# Persistent storage volume. Keep both of these off the application drive so a
# rebuild or redeploy never destroys member uploads or backup history.
#
# Member-uploaded avatars. Served through /member-avatars/<file> rather than the
# public directory whenever this is set. Defaults to the web app's private
# member-avatars directory when omitted. Example: N:\The Habitat\avatars
HABITAT_AVATAR_STORAGE_PATH=
# Destination for scripts\backup-habitat.ps1 (database, config, Git history, avatars).
# Example: N:\The Habitat\backups
HABITAT_BACKUP_PATH=

# ---------------------------------------------------------------------------
# Twitch streaming showcase (/streams)
# ---------------------------------------------------------------------------
# Create an application at https://dev.twitch.tv/console/apps. Category
# "Website Integration", client type "Confidential". Register this exact OAuth
# redirect URL on the app, or channel verification will be rejected by Twitch:
#   https://<your public origin>/api/twitch/callback
# Leave the client id or secret blank to keep the whole showcase dormant: the
# page then reports that live status is unavailable rather than implying that
# nobody is streaming.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Set to "off" to disable the integration while keeping the credentials.
TWITCH_INTEGRATION=
# Live-status poll cadence in minutes (1-60, default 2). Live state is only as
# fresh as this interval.
TWITCH_LIVE_POLL_MINUTES=2
# Bounded daily Helix request allowance, mirroring the other providers.
TWITCH_DAILY_REQUEST_BUDGET=5000

# ---------------------------------------------------------------------------
# Operational observability (Habitat Pulse and OpenTelemetry)
# ---------------------------------------------------------------------------
# How often the worker re-evaluates the Pulse signals (30000-3600000, default
# 60000). Each evaluation probes the public origin and the private agent, so it
# runs on its own cadence rather than on the 15-second monitoring cycle.
HABITAT_PULSE_INTERVAL_MS=60000
#
# OpenTelemetry is dormant until an OTLP/HTTP endpoint is set. Point it at the
# collector from docker-compose.yml to turn traces and metrics on:
#   HABITAT_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# The standard OTEL_EXPORTER_OTLP_ENDPOINT is honoured too; this one wins.
HABITAT_OTEL_EXPORTER_OTLP_ENDPOINT=
# Set to "off" to disable telemetry while keeping the endpoint configured.
HABITAT_OTEL=
HABITAT_OTEL_SERVICE_NAMESPACE=habitat
HABITAT_OTEL_ENVIRONMENT=production
# Metric export cadence in milliseconds (5000-300000, default 60000).
HABITAT_OTEL_METRIC_INTERVAL_MS=60000
# Trace sampling ratio, 0 to 1. A private clubhouse is low traffic, so the
# default records everything.
HABITAT_OTEL_TRACE_SAMPLE_RATIO=1
# Optional "key=value,key=value" headers, for a collector that authenticates.
HABITAT_OTEL_EXPORTER_OTLP_HEADERS=
# Grafana's admin password. Grafana is published on loopback only, but the
# compose file refuses to start without a real value here.
HABITAT_GRAFANA_PASSWORD=replace_me
# Loopback port Grafana is published on (default 3009). 3000 belongs to the web
# app; 3001 is often already taken by a WSL relay on a Docker Desktop host.
HABITAT_GRAFANA_PORT=3009
#
# The agent runs on the game host, so exporting from it means reaching the
# collector across the private network. It is deliberately a separate decision:
# set HABITAT_OTEL_EXPORTER_OTLP_ENDPOINT in the AGENT's own environment, and
# publish the collector's 4318 on the private interface rather than loopback.

# Discord streaming presence is OPTIONAL and off by default. Detecting that a
# member is broadcasting requires the privileged GUILD_PRESENCES intent, which
# must first be enabled under Bot -> Privileged Gateway Intents in the Discord
# developer portal (Server Members and Presence). Set to "on" only after
# enabling it there; the bot logs a warning and keeps running without it.
# Discord presence proves only that a member is streaming, never where to, so it
# is always shown as a separate signal from verified Twitch live state.
HABITAT_DISCORD_PRESENCE=off

# The Story Codex assistant ("The Warden") — a Gemini-backed helper that reads
# the Martino story map and answers the crew's questions about it. Member-only
# and fully audited: every exchange lands a StoryAssistantMessage row readable
# at /admin/story, including questions refused before they reach Google.
#
# Unset GEMINI_API_KEY (or set HABITAT_STORY_ASSISTANT=off) and the assistant
# reports itself unavailable rather than answering from nothing. The codex works
# perfectly well without it.
GEMINI_API_KEY=
# Model id, interpolated into the request path. Change this here rather than in
# code if Google rejects it — the client reports an unknown model plainly.
GEMINI_MODEL=gemini-3.7-flash
HABITAT_STORY_ASSISTANT=on
# No Habitat-side quota: the key runs on Gemini's free tier, which enforces its
# own ceiling and reports it as a 429. Usage is still counted and audited.
