# Required when the database foundation is enabled.
DATABASE_URL=postgresql://habitat_app:replace_me@localhost:5432/habitat?schema=public

# Auth.js / Discord values for Phase 2. Never commit the real values.
AUTH_SECRET=replace_with_a_long_random_value
AUTH_TRUST_HOST=true
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
BOOTSTRAP_ADMIN_EMAIL=

# Server-side integration secrets for later phases.
HABITAT_AGENT_TOKEN=
HABITAT_AGENT_URL=
HABITAT_WORKER_POLL_INTERVAL_MS=15000
HABITAT_WORKER_HISTORY_SCAN_INTERVAL_MS=21600000
HABITAT_ENCRYPTION_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
CLOUDFLARE_TUNNEL_TOKEN=

# Persistent storage volume. Keep both of these off the application drive so a
# rebuild or redeploy never destroys member uploads or backup history.
#
# Member-uploaded avatars. Served through /member-avatars/<file> rather than the
# public directory whenever this is set. Defaults to the web app's private
# member-avatars directory when omitted. Example: N:\The Habitat\avatars
HABITAT_AVATAR_STORAGE_PATH=
# Destination for scripts\backup-habitat.ps1 (database, config, Git history, avatars).
# Example: N:\The Habitat\backups
HABITAT_BACKUP_PATH=
