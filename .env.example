# Required when the database foundation is enabled.
DATABASE_URL=postgresql://habitat_app:replace_me@localhost:5432/habitat?schema=public

# Auth.js / Discord values for Phase 2. Never commit the real values.
AUTH_SECRET=replace_with_a_long_random_value
AUTH_TRUST_HOST=true
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
BOOTSTRAP_ADMIN_EMAIL=

# Server-side integration secrets for later phases.
HABITAT_AGENT_TOKEN=
HABITAT_AGENT_URL=
HABITAT_WORKER_POLL_INTERVAL_MS=15000
HABITAT_ENCRYPTION_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
CLOUDFLARE_TUNNEL_TOKEN=
