# MartServ102 only. Keep the real file local and never commit it.
HABITAT_AGENT_TOKEN=replace_with_a_32_character_or_longer_random_secret
HABITAT_AGENT_BIND_HOST=
HABITAT_AGENT_ALLOWED_IPS=
HABITAT_AGENT_PORT=4317
# Required only when agent.config.json enables the local Palworld REST query.
HABITAT_PALWORLD_ADMIN_PASSWORD=
# Optional. Absolute path to the agent configuration file; defaults to
# agent.config.json in the working directory when left blank.
HABITAT_AGENT_CONFIG_PATH=
