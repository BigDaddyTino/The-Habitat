<service>
  <id>HabitatAgent</id>
  <name>Habitat Agent</name>
  <description>Private MartServ102 monitoring service for The Habitat.</description>
  <executable>{{NODE_EXE}}</executable>
  <arguments>dist\index.js</arguments>
  <workingdirectory>{{AGENT_ROOT}}</workingdirectory>
  <logpath>{{AGENT_ROOT}}\logs</logpath>
  <!-- sizeThreshold is in KB, not bytes: 10240 KB is the intended 10 MB. -->
  <log mode="roll-by-size-time">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>14</keepFiles>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
  </log>
  <env name="NODE_ENV" value="production" />
  <stoptimeout>15sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="none" />
</service>
