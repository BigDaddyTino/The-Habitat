@echo off
setlocal enableextensions
cd /d "%~dp0"

set LOGTIMESTAMP=
for /f "skip=1 tokens=1-6" %%G in ('WMIC Path Win32_LocalTime Get Day^,Hour^,Minute^,Month^,Second^,Year /Format:table') do (
  if "%%~L"=="" goto timestamp_done
  set _yyyy=%%L
  set _mm=00%%J
  set _dd=00%%G
  set _hour=00%%H
  set _minute=00%%I
  set _second=00%%K
)
:timestamp_done
set _mm=%_mm:~-2%
set _dd=%_dd:~-2%
set _hour=%_hour:~-2%
set _minute=%_minute:~-2%
set _second=%_second:~-2%
set LOGTIMESTAMP=__%_yyyy%-%_mm%-%_dd%__%_hour%-%_minute%-%_second%

echo|set /p="251570" > steam_appid.txt
set SteamAppId=251570
set SteamGameId=251570
set LOGFILE=%~dp0output_log_dedi%LOGTIMESTAMP%.txt

7DaysToDieServer.exe -logfile "%LOGFILE%" -quit -batchmode -nographics -configfile=serverconfig.xml -dedicated
