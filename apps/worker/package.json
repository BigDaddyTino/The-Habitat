{
  "name": "@habitat/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "run-once": "tsx src/index.ts --once",
    "check:connections": "tsx src/connection-check.ts",
    "reconcile-achievements": "tsx src/reconcile-achievements.ts",
    "reconcile-identity-names": "tsx src/reconcile-identity-names.ts",
    "cleanup-duplicate-joins": "tsx src/cleanup-duplicate-joins.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@habitat/db": "workspace:*",
    "@habitat/shared": "workspace:*",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
