<service>
  <id>HabitatWeb</id>
  <name>Habitat Web</name>
  <description>Loopback-only Next.js application service for The Habitat.</description>
  <executable>node.exe</executable>
  <arguments>node_modules\next\dist\bin\next start -H 127.0.0.1 -p 3000</arguments>
  <workingdirectory>{{INSTALL_ROOT}}\apps\web</workingdirectory>
  <logpath>web-logs</logpath>
  <log mode="append" />
  <env name="NODE_ENV" value="production" />
  <stoptimeout>20sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="none" />
</service>
