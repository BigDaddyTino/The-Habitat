{
  "uid": "habitat-services",
  "title": "Habitat services",
  "tags": ["habitat"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "description": "Cross-service overview for the web app, worker and agent. Request and error rates are derived from the same low-cardinality spans retained in Tempo; native HTTP and database instruments supply the client panels.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Inbound request rate by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "habitat-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server errors by service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "habitat-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Outbound call rate by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "habitat-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (service_name) (rate({__name__=~\"http_client_request_duration_seconds_count|http_client_duration_milliseconds_count\"}[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Database operation rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "habitat-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (service_name) (rate(db_client_operation_duration_seconds_count[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Reporting services",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "habitat-prometheus" },
      "description": "A service missing here is emitting nothing — either it is down, or its OTLP endpoint is unset. Habitat Pulse is the authority on which of the two it is.",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "count by (service_name) (traces_span_metrics_calls_total{service_name=~\"habitat-.*\"})",
          "legendFormat": "{{service_name}}"
        }
      ]
    }
  ]
}
