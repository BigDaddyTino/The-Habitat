<service>
  <id>HabitatWorker</id>
  <name>Habitat Worker</name>
  <description>Private MartServ101 monitoring worker for The Habitat.</description>
  <executable>node.exe</executable>
  <arguments>apps\worker\node_modules\tsx\dist\cli.mjs apps\worker\src\bootstrap.ts</arguments>
  <workingdirectory>C:\The Habitat</workingdirectory>
  <!-- Absolute on purpose. WinSW resolves a relative logpath against the service
       process's working directory, which is C:\Windows\System32 for a LocalSystem
       service, so stdout and stderr land there while only the wrapper log appears
       beside the executable. -->
  <logpath>C:\The Habitat\worker-logs</logpath>
  <!-- sizeThreshold is in KB, not bytes: 10240 KB is the intended 10 MB. -->
  <log mode="roll-by-size-time">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>14</keepFiles>
    <pattern>yyyyMMdd</pattern>
  </log>
  <env name="NODE_ENV" value="production" />
  <stoptimeout>15sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
</service>
