node_modules/
.next/
# Versioned release builds from deploy-web.ps1 — the active one is named in
# HabitatWeb.xml, and superseded ones are kept on disk for rollback.
.next-*/
dist/
apps/agent/dist.building/
apps/agent/dist.previous/
apps/agent/dist.failed.*/
coverage/
.env
.env.local
.env.*.local
!.env.example
apps/agent/agent.config.json
apps/agent/HabitatAgent.exe
apps/agent/HabitatAgent.xml
apps/agent/logs/
apps/agent/game-services.json
apps/agent/game-services/
HabitatWorker.exe
HabitatWorker.xml
HabitatWorker.xml.bak
worker-logs/
CodexSyncPublisher.exe
CodexSyncPublisher.xml
codex-sync-logs/
HabitatWeb.exe
HabitatWeb.xml
web-logs/
# Generated from the compiled stylesheet by qa-bloomfall-systems; rebuild it
# with pnpm --filter @habitat/web bloomfall:systems:qa rather than committing it.
apps/web/private/codex-art/bloomfall-systems/review/
apps/web/public/member-avatars/*
!apps/web/public/member-avatars/.gitkeep
*.log
*.tsbuildinfo
packages/db/src/generated/
data/
backups/

# Bloomfall image-generation history is local review evidence. Release-selected
# files are copied into tracked production-shaped paths and hash-locked there.
apps/web/private/codex-art/bloomfall/
apps/web/scripts/build-bloomfall-visual-package.mjs
apps/web/scripts/build-bloomfall-visual-v2-evidence.mjs
apps/web/scripts/build-bloomfall-visual-v3-reset-evidence.mjs
apps/web/scripts/serve-bloomfall-visual-gallery.mjs

# Superseded visual-direction records remain local history; the V3 release
# contract and final owner report are tracked separately.
Docs/BLOOMFALL_REACH_VISUAL_BIBLE.md
Docs/BLOOMFALL_REACH_VISUAL_BIBLE_V2.md
Docs/BLOOMFALL_REACH_VISUAL_PROMPTS.md
Docs/BLOOMFALL_REACH_VISUAL_REPORT.md
Docs/BLOOMFALL_REACH_VISUAL_V2_PROMPTS.md
Docs/BLOOMFALL_REACH_VISUAL_V2_REPORT.md

# Throwaway inspection scripts used during a release; never part of one.
apps/web/scripts/tmp/

# Resized copies of codex art, made on demand by the /codex-art route. Derived
# output with the original's size and mtime in every filename, so it rebuilds
# itself the moment it is wrong. Deliberately a sibling of codex-art rather
# than a shelf inside it: everything under codex-art is enumerated by the
# release audit and swept into the machine bundle, and derivatives are neither.
apps/web/private/codex-art-cache/

.codex-tmp-*

# Art-run scratch (sources, QA crops, one-off installers) — kept on disk, never committed
/tmp/
/.tmp/

# Regenerated by every `next build`/`next dev` with the release stamp baked in
apps/web/next-env.d.ts

# In-flight art verification, tracked once its ledger and plates exist.
apps/web/lib/lamplight-road-art.test.ts
