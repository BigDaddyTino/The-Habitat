generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  VIEWER
}

enum GameType {
  SEVEN_DAYS_TO_DIE
  PROJECT_ZOMBOID
  DRAGONWILDS
  ENSHROUDED
  PALWORLD
  VALHEIM
}

enum ClubGameType {
  MARVEL_RIVALS
}

enum ClubProfileSyncStatus {
  READY
  PRIVATE
  ERROR
}

enum ProviderSyncStatus {
  PENDING
  READY
  PRIVATE
  ERROR
}

enum ClubMatchResult {
  WIN
  LOSS
  DRAW
  UNKNOWN
}

enum SteamAchievementSyncStatus {
  PENDING
  READY
  PRIVATE
  UNSUPPORTED
  ERROR
}

enum ServerState {
  ONLINE
  STARTING
  STOPPING
  SLEEPING
  UPDATING
  DEGRADED
  DOWN_UNEXPECTEDLY
  UNKNOWN
}

enum ServerEventType {
  SERVER_STARTED
  SERVER_STOPPED
  SERVER_SLEEPING
  SERVER_CRASHED
  SERVER_UPDATED
  PLAYER_JOINED
  PLAYER_LEFT
  PLAYER_DIED
  PLAYER_KILLED
  BOSS_KILLED
  CHAT_MESSAGE
  WORLD_SAVED
  BACKUP_CREATED
  ACHIEVEMENT_EARNED
  RECORD_BROKEN
  ADMIN_ANNOUNCEMENT
  WAKE_REQUESTED
  WAKE_APPROVED
}

enum ChronicleReactionType {
  SKULL
  FIRE
  FACEPALM
  CROWN
  SKILL_ISSUE
}

enum IdentityClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserTitleSource {
  ADMIN
  ACHIEVEMENT
}

enum AchievementRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  QUESTIONABLE_LIFE_CHOICE
}

enum AchievementRuleType {
  EVENT_COUNT
  GAME_EVENT_COUNT
  DISTINCT_GAME_EVENT_COUNT
  LEGACY_EVIDENCE_COUNT
  LEVEL_REACHED
  WEB_INTERACTION
  ACTIVITY_COUNT
  ACTIVITY_VALUE_SUM
  DISTINCT_ACTIVITY_GAME_COUNT
  ORDERED_ACTIVITY_STREAK
  SHARED_ACTIVITY_COUNT
  ACTIVITY_STAT_THRESHOLD
}

enum LegacyEvidenceKind {
  PARTICIPATION
  SESSION
}

enum XpSource {
  VERIFIED_PLAYTIME
  WEEKLY_QUEST
}

enum WeeklyQuestRuleType {
  PLAY_SECONDS
  JOIN_COUNT
  DISTINCT_GAME_COUNT
}

enum AchievementRewardKind {
  TITLE
  AVATAR_BORDER
  PROFILE_LAYOUT
  BADGE
  MEDAL
  TROPHY
}

enum SocialPlatform {
  TWITCH
  STEAM
  DISCORD
  YOUTUBE
  XBOX
  PLAYSTATION
  EPIC_GAMES
  BATTLE_NET
  RIOT_GAMES
  GITHUB
}

enum RecordHall {
  LEGENDS
  SHAME
}

enum RecordRuleType {
  PLAYER_EVENT_COUNT
  DISTINCT_GAME_EVENT_COUNT
  ACHIEVEMENT_COUNT
  ACTIVITY_COUNT
  ACTIVITY_VALUE_SUM
  ACTIVITY_DISTINCT_GAME_COUNT
}

enum RecordComparison {
  MAX
  MIN
}

enum DiscordNotificationKind {
  SERVER_ONLINE
  SERVER_SLEEPING
  SERVER_OUTAGE
  RECORD_BROKEN
  LEGENDARY_ACHIEVEMENT
  WAKE_REQUEST
  WEEKLY_CHRONICLE
}

enum WakeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ServerPollStatus {
  ACTIVE
  CLOSED
}

enum ServerCommandAction {
  START
  STOP
  RESTART
  UPDATE
}

enum ServerCommandStatus {
  REQUESTED
  AUTHORIZED
  DISPATCHED
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
}

model User {
  id                     String                    @id @default(uuid()) @db.Uuid
  name                   String?
  username               String?                   @unique
  displayName            String?
  email                  String?                   @unique
  emailVerified          DateTime?
  role                   Role                      @default(VIEWER)
  image                  String?
  bio                    String?                   @db.VarChar(500)
  avatarBorder           String?                   @db.VarChar(64)
  profileLayout          String?                   @db.VarChar(64)
  isActive               Boolean                   @default(false)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  accounts               Account[]
  sessions               Session[]
  playerIdentities       PlayerIdentity[]
  auditLogs              AuditLog[]
  chronicleReactions     ChronicleReaction[]
  identityClaims         PlayerIdentityClaim[]     @relation("IdentityClaimant")
  resolvedIdentityClaims PlayerIdentityClaim[]     @relation("IdentityClaimResolver")
  titles                 UserTitle[]               @relation("TitleOwner")
  awardedTitles          UserTitle[]               @relation("TitleAwarder")
  achievements           PlayerAchievement[]
  recordHolders          RecordHolder[]            @relation("RecordHolderUser")
  recordHistory          RecordHistory[]           @relation("RecordHistoryUser")
  wakeRequests           WakeRequest[]             @relation("WakeRequestRequester")
  resolvedWakeRequests   WakeRequest[]             @relation("WakeRequestResolver")
  wakeVotes              WakeVote[]
  pollsCreated           ServerPoll[]              @relation("PollCreator")
  pollVotes              ServerPollVote[]
  serverCommands         ServerCommand[]
  socialAccounts         UserSocialAccount[]
  unlockedRewards        UserAchievementReward[]
  steamLinkNonces        SteamLinkNonce[]
  xpEntries              UserXpEntry[]
  weeklyQuestProgress    UserWeeklyQuestProgress[]
  identityReconciliations IdentityRewardReconciliation[]
  clubGameProfiles        ClubGameProfile[]
  gameActivities          GameActivity[]
  invitationsSent         Invitation[]                @relation("InvitationSender")
  memberPresence          MemberPresence?
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  role            Role      @default(USER)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  invitedByUserId String?   @db.Uuid
  invitedBy       User?     @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([invitedByUserId, createdAt])
}

model MemberPresence {
  userId       String   @id @db.Uuid
  authProvider String   @default("Discord") @db.VarChar(32)
  deviceType   String   @db.VarChar(32)
  platform     String   @db.VarChar(64)
  browser      String   @db.VarChar(64)
  lastSeenAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastSeenAt])
}

model GameServer {
  id                   String                 @id @default(uuid()) @db.Uuid
  slug                 String                 @unique
  displayName          String
  gameType             GameType
  worldName            String
  description          String?
  enabled              Boolean                @default(true)
  controlEnabled       Boolean                @default(false)
  desiredState         ServerState            @default(SLEEPING)
  actualState          ServerState            @default(UNKNOWN)
  lastStateChangeAt    DateTime?
  lastQueryAt          DateTime?
  lastOnlineAt         DateTime?
  currentVersion       String?
  currentBuildId       String?
  maxPlayers           Int?
  adapterType          String
  capabilities         Json
  publicNotes          String?
  adminNotes           String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  runtimeState         ServerRuntimeState?
  statusHistory        ServerStatusHistory[]
  metricSamples        ServerMetricSample[]
  events               ServerEvent[]
  playerIdentities     PlayerIdentity[]
  playerPresence       ServerPlayerPresence[]
  legacyPlayerEvidence LegacyPlayerEvidence[]
  wakeRequests         WakeRequest[]
  pollOptions          ServerPollOption[]
  commands             ServerCommand[]
}

model ServerRuntimeState {
  id               String      @id @default(uuid()) @db.Uuid
  serverId         String      @unique @db.Uuid
  state            ServerState @default(UNKNOWN)
  reachable        Boolean?
  playerCount      Int?
  maxPlayers       Int?
  pingMs           Int?
  version          String?
  buildId          String?
  processRunning   Boolean?
  processStartedAt DateTime?
  observedAt       DateTime    @default(now())
  details          Json?
  server           GameServer  @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model ServerStatusHistory {
  id           String       @id @default(uuid()) @db.Uuid
  serverId     String       @db.Uuid
  state        ServerState
  desiredState ServerState?
  observedAt   DateTime     @default(now())
  reason       String?
  details      Json?
  server       GameServer   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, observedAt])
}

model ServerMetricSample {
  id                 String     @id @default(uuid()) @db.Uuid
  serverId           String     @db.Uuid
  observedAt         DateTime
  playerCount        Int?
  maxPlayers         Int?
  pingMs             Int?
  processMemoryBytes BigInt?
  cpuSeconds         Float?
  diskFreeBytes      BigInt?
  diskTotalBytes     BigInt?
  source             String
  server             GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, observedAt])
}

model PlayerIdentity {
  id                String                 @id @default(uuid()) @db.Uuid
  userId            String?                @db.Uuid
  serverId          String?                @db.Uuid
  gameType          GameType
  displayName       String
  providerKey       String
  externalProvider  SocialPlatform?
  externalAccountId String?                @db.VarChar(80)
  verifiedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  server            GameServer?            @relation(fields: [serverId], references: [id], onDelete: SetNull)
  events            ServerEvent[]
  claims            PlayerIdentityClaim[]
  recordHolders     RecordHolder[]
  recordHistory     RecordHistory[]
  legacyEvidence    LegacyPlayerEvidence[]
  reconciliation    IdentityRewardReconciliation?

  @@unique([gameType, providerKey])
  @@index([externalProvider, externalAccountId])
}

model PlayerIdentityClaim {
  id               String              @id @default(uuid()) @db.Uuid
  playerIdentityId String              @db.Uuid
  userId           String              @db.Uuid
  status           IdentityClaimStatus @default(PENDING)
  requestedAt      DateTime            @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?             @db.Uuid
  resolutionNote   String?
  playerIdentity   PlayerIdentity      @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)
  user             User                @relation("IdentityClaimant", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy       User?               @relation("IdentityClaimResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([playerIdentityId, userId])
  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}

model IdentityRewardReconciliation {
  id               String          @id @default(uuid()) @db.Uuid
  playerIdentityId String          @unique @db.Uuid
  userId           String          @db.Uuid
  queuedAt         DateTime        @default(now())
  completedAt      DateTime?
  attempts         Int             @default(0)
  lastError        String?         @db.VarChar(180)
  playerIdentity   PlayerIdentity  @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([completedAt, queuedAt])
  @@index([userId, completedAt])
}

model LegacyPlayerEvidence {
  id               String             @id @default(uuid()) @db.Uuid
  serverId         String             @db.Uuid
  playerIdentityId String             @db.Uuid
  gameType         GameType
  kind             LegacyEvidenceKind
  occurredAt       DateTime
  endedAt          DateTime?
  durationSeconds  Int?
  sourceKind       String             @db.VarChar(40)
  sourceLabel      String             @db.VarChar(80)
  sourceRecordHash String             @db.VarChar(64)
  importedAt       DateTime           @default(now())
  dedupeKey        String             @unique @db.VarChar(220)
  server           GameServer         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  playerIdentity   PlayerIdentity     @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)

  @@index([serverId, occurredAt])
  @@index([playerIdentityId, occurredAt])
  @@index([kind, occurredAt])
}

/// Hand-written SQL constraint (migration 20260811183000_add_progression_constraints):
/// CHECK "UserXpEntry_amount_positive" ("amount" > 0).
/// It exists only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop it.
model UserXpEntry {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  serverEventId String?      @db.Uuid
  source        XpSource
  amount        Int
  description   String       @db.VarChar(160)
  earnedAt      DateTime     @default(now())
  dedupeKey     String       @unique @db.VarChar(220)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverEvent   ServerEvent? @relation(fields: [serverEventId], references: [id], onDelete: SetNull)

  @@index([userId, earnedAt])
  @@index([source, earnedAt])
}

/// Hand-written SQL constraints (migration 20260811183000_add_progression_constraints):
/// CHECK "WeeklyQuestDefinition_threshold_positive" ("threshold" > 0) and
/// CHECK "WeeklyQuestDefinition_xpReward_positive" ("xpReward" > 0).
/// They exist only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop them.
model WeeklyQuestDefinition {
  id          String                 @id @default(uuid()) @db.Uuid
  slug        String                 @unique @db.VarChar(80)
  name        String                 @db.VarChar(100)
  description String                 @db.VarChar(240)
  ruleType    WeeklyQuestRuleType
  threshold   Int
  xpReward    Int
  icon        String?                @db.VarChar(40)
  enabled     Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  selections  WeeklyQuestSelection[]
}

/// Hand-written SQL constraint (migration 20260811183000_add_progression_constraints):
/// CHECK "WeeklyQuestCycle_valid_window" ("endsAt" > "weekStart").
/// It exists only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop it.
model WeeklyQuestCycle {
  id         String                 @id @default(uuid()) @db.Uuid
  weekStart  DateTime               @unique
  endsAt     DateTime
  createdAt  DateTime               @default(now())
  selections WeeklyQuestSelection[]
}

/// Hand-written SQL constraint (migration 20260811183000_add_progression_constraints):
/// CHECK "WeeklyQuestSelection_sortOrder_valid" ("sortOrder" >= 0 AND "sortOrder" < 16).
/// It exists only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop it.
model WeeklyQuestSelection {
  id           String                    @id @default(uuid()) @db.Uuid
  cycleId      String                    @db.Uuid
  definitionId String                    @db.Uuid
  sortOrder    Int
  cycle        WeeklyQuestCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  definition   WeeklyQuestDefinition     @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  progress     UserWeeklyQuestProgress[]

  @@unique([cycleId, definitionId])
  @@index([cycleId, sortOrder])
}

/// Hand-written SQL constraint (migration 20260811183000_add_progression_constraints):
/// CHECK "UserWeeklyQuestProgress_nonnegative" ("progress" >= 0).
/// It exists only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop it.
model UserWeeklyQuestProgress {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  selectionId String               @db.Uuid
  progress    Int                  @default(0)
  completedAt DateTime?
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  selection   WeeklyQuestSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@unique([userId, selectionId])
  @@index([userId, completedAt])
}

model TitleDefinition {
  id                 String              @id @default(uuid()) @db.Uuid
  slug               String              @unique
  name               String              @unique
  description        String?
  enabled            Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  userTitles         UserTitle[]
  achievementRewards AchievementReward[]
}

/// Hand-written SQL constraint (migration 20260810204000_enforce_one_equipped_title):
/// partial unique index "UserTitle_one_equipped_per_user" ON ("userId") WHERE "equipped" = true.
/// It exists only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop it.
model UserTitle {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  titleDefinitionId String          @db.Uuid
  source            UserTitleSource
  equipped          Boolean         @default(false)
  awardedAt         DateTime        @default(now())
  awardedByUserId   String?         @db.Uuid
  user              User            @relation("TitleOwner", fields: [userId], references: [id], onDelete: Cascade)
  title             TitleDefinition @relation(fields: [titleDefinitionId], references: [id], onDelete: Cascade)
  awardedBy         User?           @relation("TitleAwarder", fields: [awardedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, titleDefinitionId])
  @@index([userId, equipped])
}

model AchievementDefinition {
  id                String              @id @default(uuid()) @db.Uuid
  slug              String              @unique
  name              String
  description       String
  secretDescription String?
  icon              String?
  gameType          GameType?
  gameKey           String?             @db.VarChar(40)
  rarity            AchievementRarity
  category          String
  ruleType          AchievementRuleType
  ruleConfig        Json
  isSecret          Boolean             @default(false)
  isRepeatable      Boolean             @default(false)
  points            Int                 @default(0)
  enabled           Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  awards            PlayerAchievement[]
  rewards           AchievementReward[]
}

model AchievementReward {
  id                      String                  @id @default(uuid()) @db.Uuid
  achievementDefinitionId String                  @db.Uuid
  kind                    AchievementRewardKind
  code                    String                  @db.VarChar(64)
  name                    String                  @db.VarChar(80)
  description             String?                 @db.VarChar(180)
  titleDefinitionId       String?                 @db.Uuid
  achievement             AchievementDefinition   @relation(fields: [achievementDefinitionId], references: [id], onDelete: Cascade)
  title                   TitleDefinition?        @relation(fields: [titleDefinitionId], references: [id], onDelete: SetNull)
  unlocks                 UserAchievementReward[]

  @@unique([achievementDefinitionId, kind, code])
  @@index([achievementDefinitionId])
}

model UserAchievementReward {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @db.Uuid
  achievementRewardId String             @db.Uuid
  playerAchievementId String?            @db.Uuid
  unlockedAt          DateTime           @default(now())
  equipped            Boolean            @default(false)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward              AchievementReward  @relation(fields: [achievementRewardId], references: [id], onDelete: Cascade)
  playerAchievement   PlayerAchievement? @relation(fields: [playerAchievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementRewardId])
  @@index([userId, equipped])
}

model PlayerAchievement {
  id                      String                  @id @default(uuid()) @db.Uuid
  userId                  String                  @db.Uuid
  achievementDefinitionId String                  @db.Uuid
  sourceEventId           String?                 @db.Uuid
  sourceActivityId        String?                 @db.Uuid
  awardedAt               DateTime                @default(now())
  dedupeKey               String                  @unique
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement             AchievementDefinition   @relation(fields: [achievementDefinitionId], references: [id], onDelete: Cascade)
  sourceActivity          GameActivity?            @relation(fields: [sourceActivityId], references: [id], onDelete: Cascade)
  unlockedRewards         UserAchievementReward[]

  @@index([userId, awardedAt])
  @@index([achievementDefinitionId, awardedAt])
  @@index([sourceActivityId])
}

model UserSocialAccount {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  platform          SocialPlatform
  handle            String         @db.VarChar(80)
  profileUrl        String?        @db.VarChar(300)
  providerAccountId String?        @db.VarChar(80)
  verifiedAt        DateTime?
  displayPublic     Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  steamProfile      SteamProfile?

  @@unique([userId, platform])
  @@unique([platform, handle])
  @@unique([platform, providerAccountId])
  @@index([userId, displayPublic])
}

model SteamProfile {
  id                         String             @id @default(uuid()) @db.Uuid
  socialAccountId            String             @unique @db.Uuid
  enrichmentEnabledAt        DateTime
  displayPublic              Boolean            @default(false)
  personaName                String?            @db.VarChar(80)
  profileUrl                 String?            @db.VarChar(300)
  avatarUrl                  String?            @db.VarChar(500)
  avatarMediumUrl            String?            @db.VarChar(500)
  avatarFullUrl              String?            @db.VarChar(500)
  communityVisibilityState   Int?
  profileState               Int?
  steamCreatedAt             DateTime?
  lastLogoffAt               DateTime?
  currentGameAppId           Int?
  currentGameName            String?            @db.VarChar(160)
  profileStatus              ProviderSyncStatus @default(PENDING)
  profileLastAttemptedAt     DateTime?
  profileLastSuccessfulAt    DateTime?
  profileNextAttemptAt       DateTime?
  profileConsecutiveFailures Int                @default(0)
  profileSyncError           String?            @db.VarChar(180)
  libraryStatus              ProviderSyncStatus @default(PENDING)
  libraryLastAttemptedAt     DateTime?
  libraryLastSuccessfulAt    DateTime?
  libraryNextAttemptAt       DateTime?
  libraryConsecutiveFailures Int                @default(0)
  librarySyncError           String?            @db.VarChar(180)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  socialAccount              UserSocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  libraryGames               SteamLibraryGame[]
  achievementSyncs           SteamAchievementSync[]
  userAchievements           SteamUserAchievement[]

  @@index([profileNextAttemptAt])
  @@index([libraryNextAttemptAt])
}

model SteamApp {
  appId          Int                @id
  name           String             @db.VarChar(200)
  iconHash       String?            @db.VarChar(100)
  metadataSeenAt DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  libraryGames   SteamLibraryGame[]
  achievementSchemaStatus           SteamAchievementSyncStatus @default(PENDING)
  achievementSchemaLastAttemptedAt  DateTime?
  achievementSchemaLastSuccessfulAt DateTime?
  achievementSchemaNextAttemptAt    DateTime?
  achievementSchemaSyncError        String?                    @db.VarChar(180)
  achievementDefinitions            SteamAchievementDefinition[]
  achievementSyncs                  SteamAchievementSync[]
}

model SteamLibraryGame {
  id                      String       @id @default(uuid()) @db.Uuid
  steamProfileId          String       @db.Uuid
  steamAppId              Int
  playtimeMinutes         Int          @default(0)
  playtimeTwoWeeksMinutes Int?
  lastPlayedAt            DateTime?
  lastSeenAt              DateTime
  isCurrent               Boolean      @default(true)
  metadata                Json?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  steamProfile            SteamProfile @relation(fields: [steamProfileId], references: [id], onDelete: Cascade)
  app                     SteamApp     @relation(fields: [steamAppId], references: [appId], onDelete: Restrict)

  @@unique([steamProfileId, steamAppId])
  @@index([steamProfileId, isCurrent, playtimeMinutes])
  @@index([steamProfileId, lastPlayedAt])
}

model SteamAchievementDefinition {
  id             String                 @id @default(uuid()) @db.Uuid
  steamAppId     Int
  apiName        String                 @db.VarChar(200)
  displayName    String                 @db.VarChar(200)
  description    String?                @db.VarChar(500)
  hidden         Boolean                @default(false)
  iconUrl        String?                @db.VarChar(500)
  iconGrayUrl    String?                @db.VarChar(500)
  globalPercent  Float?
  lastSeenAt     DateTime
  isCurrent      Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
