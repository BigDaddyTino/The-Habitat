generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  VIEWER
}

enum GameType {
  SEVEN_DAYS_TO_DIE
  PROJECT_ZOMBOID
  DRAGONWILDS
  ENSHROUDED
  PALWORLD
  VALHEIM
}

enum ClubGameType {
  MARVEL_RIVALS
}

enum ClubProfileSyncStatus {
  READY
  PRIVATE
  ERROR
  /// The provider answered successfully but holds no career aggregates for the
  /// player, so cumulative stats stay null instead of being displayed as zero.
  NO_PROVIDER_DATA
}

enum ProviderSyncStatus {
  PENDING
  READY
  PRIVATE
  ERROR
}

enum ClubMatchResult {
  WIN
  LOSS
  DRAW
  UNKNOWN
}

enum SteamAchievementSyncStatus {
  PENDING
  READY
  PRIVATE
  UNSUPPORTED
  ERROR
}

enum ServerState {
  ONLINE
  STARTING
  STOPPING
  SLEEPING
  UPDATING
  DEGRADED
  DOWN_UNEXPECTEDLY
  UNKNOWN
}

enum ServerEventType {
  SERVER_STARTED
  SERVER_STOPPED
  SERVER_SLEEPING
  SERVER_CRASHED
  SERVER_UPDATED
  PLAYER_JOINED
  PLAYER_LEFT
  PLAYER_DIED
  PLAYER_KILLED
  BOSS_KILLED
  WORLD_GATHERING
  CHAT_MESSAGE
  WORLD_SAVED
  BACKUP_CREATED
  ACHIEVEMENT_EARNED
  RECORD_BROKEN
  ADMIN_ANNOUNCEMENT
  WAKE_REQUESTED
  WAKE_APPROVED
}

