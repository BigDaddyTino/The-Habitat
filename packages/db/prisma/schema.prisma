generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  VIEWER
}

enum GameType {
  SEVEN_DAYS_TO_DIE
  PROJECT_ZOMBOID
  DRAGONWILDS
  ENSHROUDED
  PALWORLD
  VALHEIM
}

enum ServerState {
  ONLINE
  STARTING
  STOPPING
  SLEEPING
  UPDATING
  DEGRADED
  DOWN_UNEXPECTEDLY
  UNKNOWN
}

enum ServerEventType {
  SERVER_STARTED
  SERVER_STOPPED
  SERVER_SLEEPING
  SERVER_CRASHED
  SERVER_UPDATED
  PLAYER_JOINED
  PLAYER_LEFT
  PLAYER_DIED
  PLAYER_KILLED
  BOSS_KILLED
  CHAT_MESSAGE
  WORLD_SAVED
  BACKUP_CREATED
  ACHIEVEMENT_EARNED
  RECORD_BROKEN
  ADMIN_ANNOUNCEMENT
  WAKE_REQUESTED
  WAKE_APPROVED
}

enum ChronicleReactionType {
  SKULL
  FIRE
  FACEPALM
  CROWN
  SKILL_ISSUE
}

enum IdentityClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  name             String?
  username         String?          @unique
  displayName      String?
  email            String?          @unique
  emailVerified    DateTime?
  role             Role             @default(VIEWER)
  image            String?
  isActive         Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accounts         Account[]
  sessions         Session[]
  playerIdentities PlayerIdentity[]
  auditLogs        AuditLog[]
  chronicleReactions ChronicleReaction[]
  identityClaims   PlayerIdentityClaim[] @relation("IdentityClaimant")
  resolvedIdentityClaims PlayerIdentityClaim[] @relation("IdentityClaimResolver")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  role        Role     @default(USER)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())
}

model GameServer {
  id              String                @id @default(uuid()) @db.Uuid
  slug            String                @unique
  displayName     String
  gameType        GameType
  worldName       String
  description     String?
  enabled         Boolean               @default(true)
  desiredState    ServerState           @default(SLEEPING)
  actualState     ServerState           @default(UNKNOWN)
  lastStateChangeAt DateTime?
  lastQueryAt     DateTime?
  lastOnlineAt    DateTime?
  currentVersion  String?
  currentBuildId  String?
  maxPlayers      Int?
  adapterType     String
  capabilities    Json
  publicNotes     String?
  adminNotes      String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  runtimeState    ServerRuntimeState?
  statusHistory   ServerStatusHistory[]
  metricSamples   ServerMetricSample[]
  events          ServerEvent[]
  playerIdentities PlayerIdentity[]
  playerPresence  ServerPlayerPresence[]
}

model ServerRuntimeState {
  id              String      @id @default(uuid()) @db.Uuid
  serverId        String      @unique @db.Uuid
  state           ServerState @default(UNKNOWN)
  reachable       Boolean?
  playerCount     Int?
  maxPlayers      Int?
  pingMs          Int?
  version         String?
  buildId         String?
  processRunning  Boolean?
  processStartedAt DateTime?
  observedAt      DateTime    @default(now())
  details         Json?
  server          GameServer  @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model ServerStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  serverId   String      @db.Uuid
  state      ServerState
  desiredState ServerState?
  observedAt DateTime    @default(now())
  reason     String?
  details    Json?
  server     GameServer  @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, observedAt])
}

model ServerMetricSample {
  id                 String   @id @default(uuid()) @db.Uuid
  serverId           String   @db.Uuid
  observedAt         DateTime
  playerCount        Int?
  maxPlayers         Int?
  pingMs             Int?
  processMemoryBytes BigInt?
  cpuSeconds         Float?
  diskFreeBytes      BigInt?
  diskTotalBytes     BigInt?
  source             String
  server             GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, observedAt])
}

model PlayerIdentity {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @db.Uuid
  serverId    String?     @db.Uuid
  gameType    GameType
  displayName String
  providerKey String
  verifiedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  server      GameServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  events      ServerEvent[]
  claims      PlayerIdentityClaim[]

  @@unique([gameType, providerKey])
}

model PlayerIdentityClaim {
  id               String              @id @default(uuid()) @db.Uuid
  playerIdentityId String              @db.Uuid
  userId           String              @db.Uuid
  status           IdentityClaimStatus @default(PENDING)
  requestedAt      DateTime            @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?             @db.Uuid
  resolutionNote   String?
  playerIdentity   PlayerIdentity      @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)
  user             User                @relation("IdentityClaimant", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy       User?               @relation("IdentityClaimResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([playerIdentityId, userId])
  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}

model ServerEvent {
  id               String           @id @default(uuid()) @db.Uuid
  serverId         String           @db.Uuid
  gameType         GameType
  eventType        ServerEventType
  occurredAt       DateTime
  receivedAt       DateTime         @default(now())
  playerIdentityId String?          @db.Uuid
  actorText        String?
  targetText       String?
  cause            String?
  valueNumber      Float?
  valueText        String?
  metadata         Json?
  source           String
  sourceConfidence Int              @default(100)
  dedupeKey        String?          @unique
  server           GameServer       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  playerIdentity   PlayerIdentity?  @relation(fields: [playerIdentityId], references: [id], onDelete: SetNull)
  reactions        ChronicleReaction[]

  @@index([serverId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([playerIdentityId, occurredAt])
}

model ServerPlayerPresence {
  serverId        String   @db.Uuid
  providerKey     String
  displayName     String
  present         Boolean  @default(false)
  firstObservedAt DateTime
  lastObservedAt  DateTime
  server          GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, providerKey])
  @@index([serverId, present])
}

model ChronicleReaction {
  id            String                @id @default(uuid()) @db.Uuid
  serverEventId String                @db.Uuid
  userId        String                @db.Uuid
  reactionType  ChronicleReactionType
  createdAt     DateTime              @default(now())
  serverEvent   ServerEvent           @relation(fields: [serverEventId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverEventId, userId, reactionType])
  @@index([serverEventId, reactionType])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorUserId String?   @db.Uuid
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  requestHash String?
  createdAt   DateTime  @default(now())
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
