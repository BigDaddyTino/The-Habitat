generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  VIEWER
}

enum GameType {
  SEVEN_DAYS_TO_DIE
  PROJECT_ZOMBOID
  DRAGONWILDS
  ENSHROUDED
  PALWORLD
  VALHEIM
}

enum ServerState {
  ONLINE
  STARTING
  STOPPING
  SLEEPING
  UPDATING
  DEGRADED
  DOWN_UNEXPECTEDLY
  UNKNOWN
}

enum ServerEventType {
  SERVER_STARTED
  SERVER_STOPPED
  SERVER_SLEEPING
  SERVER_CRASHED
  SERVER_UPDATED
  PLAYER_JOINED
  PLAYER_LEFT
  PLAYER_DIED
  PLAYER_KILLED
  BOSS_KILLED
  CHAT_MESSAGE
  WORLD_SAVED
  BACKUP_CREATED
  ACHIEVEMENT_EARNED
  RECORD_BROKEN
  ADMIN_ANNOUNCEMENT
  WAKE_REQUESTED
  WAKE_APPROVED
}

enum ChronicleReactionType {
  SKULL
  FIRE
  FACEPALM
  CROWN
  SKILL_ISSUE
}

enum IdentityClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserTitleSource {
  ADMIN
  ACHIEVEMENT
}

enum AchievementRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  QUESTIONABLE_LIFE_CHOICE
}

enum AchievementRuleType {
  EVENT_COUNT
  DISTINCT_GAME_EVENT_COUNT
  LEGACY_EVIDENCE_COUNT
  LEVEL_REACHED
}

enum LegacyEvidenceKind {
  PARTICIPATION
  SESSION
}

enum XpSource {
  VERIFIED_PLAYTIME
  WEEKLY_QUEST
}

enum WeeklyQuestRuleType {
  PLAY_SECONDS
  JOIN_COUNT
  DISTINCT_GAME_COUNT
}

enum AchievementRewardKind {
  TITLE
  AVATAR_BORDER
  PROFILE_LAYOUT
  BADGE
}

enum SocialPlatform {
  TWITCH
  STEAM
  DISCORD
  YOUTUBE
  XBOX
  PLAYSTATION
  EPIC_GAMES
  BATTLE_NET
  RIOT_GAMES
  GITHUB
}

enum RecordHall {
  LEGENDS
  SHAME
}

enum RecordRuleType {
  PLAYER_EVENT_COUNT
  DISTINCT_GAME_EVENT_COUNT
  ACHIEVEMENT_COUNT
}

enum DiscordNotificationKind {
  SERVER_ONLINE
  SERVER_SLEEPING
  SERVER_OUTAGE
  RECORD_BROKEN
  LEGENDARY_ACHIEVEMENT
  WAKE_REQUEST
  WEEKLY_CHRONICLE
}

enum WakeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ServerPollStatus {
  ACTIVE
  CLOSED
}

enum ServerCommandAction {
  START
  STOP
  RESTART
  UPDATE
}

enum ServerCommandStatus {
  REQUESTED
  AUTHORIZED
  DISPATCHED
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
}

model User {
  id                     String                    @id @default(uuid()) @db.Uuid
  name                   String?
  username               String?                   @unique
  displayName            String?
  email                  String?                   @unique
  emailVerified          DateTime?
  role                   Role                      @default(VIEWER)
  image                  String?
  bio                    String?                   @db.VarChar(500)
  avatarBorder           String?                   @db.VarChar(64)
  profileLayout          String?                   @db.VarChar(64)
  isActive               Boolean                   @default(false)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  accounts               Account[]
  sessions               Session[]
  playerIdentities       PlayerIdentity[]
  auditLogs              AuditLog[]
  chronicleReactions     ChronicleReaction[]
  identityClaims         PlayerIdentityClaim[]     @relation("IdentityClaimant")
  resolvedIdentityClaims PlayerIdentityClaim[]     @relation("IdentityClaimResolver")
  titles                 UserTitle[]               @relation("TitleOwner")
  awardedTitles          UserTitle[]               @relation("TitleAwarder")
  achievements           PlayerAchievement[]
  recordHolders          RecordHolder[]            @relation("RecordHolderUser")
  recordHistory          RecordHistory[]           @relation("RecordHistoryUser")
  wakeRequests           WakeRequest[]             @relation("WakeRequestRequester")
  resolvedWakeRequests   WakeRequest[]             @relation("WakeRequestResolver")
  wakeVotes              WakeVote[]
  pollsCreated           ServerPoll[]              @relation("PollCreator")
  pollVotes              ServerPollVote[]
  serverCommands         ServerCommand[]
  socialAccounts         UserSocialAccount[]
  unlockedRewards        UserAchievementReward[]
  steamLinkNonces        SteamLinkNonce[]
  xpEntries              UserXpEntry[]
  weeklyQuestProgress    UserWeeklyQuestProgress[]
  identityReconciliations IdentityRewardReconciliation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique
  role       Role      @default(USER)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}

model GameServer {
  id                   String                 @id @default(uuid()) @db.Uuid
  slug                 String                 @unique
  displayName          String
  gameType             GameType
  worldName            String
  description          String?
  enabled              Boolean                @default(true)
  controlEnabled       Boolean                @default(false)
  desiredState         ServerState            @default(SLEEPING)
  actualState          ServerState            @default(UNKNOWN)
  lastStateChangeAt    DateTime?
  lastQueryAt          DateTime?
  lastOnlineAt         DateTime?
  currentVersion       String?
  currentBuildId       String?
  maxPlayers           Int?
  adapterType          String
  capabilities         Json
  publicNotes          String?
  adminNotes           String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  runtimeState         ServerRuntimeState?
  statusHistory        ServerStatusHistory[]
  metricSamples        ServerMetricSample[]
  events               ServerEvent[]
  playerIdentities     PlayerIdentity[]
  playerPresence       ServerPlayerPresence[]
  legacyPlayerEvidence LegacyPlayerEvidence[]
  wakeRequests         WakeRequest[]
  pollOptions          ServerPollOption[]
  commands             ServerCommand[]
}

model ServerRuntimeState {
  id               String      @id @default(uuid()) @db.Uuid
  serverId         String      @unique @db.Uuid
  state            ServerState @default(UNKNOWN)
  reachable        Boolean?
  playerCount      Int?
  maxPlayers       Int?
  pingMs           Int?
  version          String?
  buildId          String?
  processRunning   Boolean?
  processStartedAt DateTime?
  observedAt       DateTime    @default(now())
  details          Json?
  server           GameServer  @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model ServerStatusHistory {
  id           String       @id @default(uuid()) @db.Uuid
  serverId     String       @db.Uuid
  state        ServerState
  desiredState ServerState?
  observedAt   DateTime     @default(now())
  reason       String?
  details      Json?
  server       GameServer   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, observedAt])
}

model ServerMetricSample {
  id                 String     @id @default(uuid()) @db.Uuid
  serverId           String     @db.Uuid
  observedAt         DateTime
  playerCount        Int?
  maxPlayers         Int?
  pingMs             Int?
  processMemoryBytes BigInt?
  cpuSeconds         Float?
  diskFreeBytes      BigInt?
  diskTotalBytes     BigInt?
  source             String
  server             GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, observedAt])
}

model PlayerIdentity {
  id                String                 @id @default(uuid()) @db.Uuid
  userId            String?                @db.Uuid
  serverId          String?                @db.Uuid
  gameType          GameType
  displayName       String
  providerKey       String
  externalProvider  SocialPlatform?
  externalAccountId String?                @db.VarChar(80)
  verifiedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  server            GameServer?            @relation(fields: [serverId], references: [id], onDelete: SetNull)
  events            ServerEvent[]
  claims            PlayerIdentityClaim[]
  recordHolders     RecordHolder[]
  recordHistory     RecordHistory[]
  legacyEvidence    LegacyPlayerEvidence[]
  reconciliation    IdentityRewardReconciliation?

  @@unique([gameType, providerKey])
  @@index([externalProvider, externalAccountId])
}

model PlayerIdentityClaim {
  id               String              @id @default(uuid()) @db.Uuid
  playerIdentityId String              @db.Uuid
  userId           String              @db.Uuid
  status           IdentityClaimStatus @default(PENDING)
  requestedAt      DateTime            @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?             @db.Uuid
  resolutionNote   String?
  playerIdentity   PlayerIdentity      @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)
  user             User                @relation("IdentityClaimant", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy       User?               @relation("IdentityClaimResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([playerIdentityId, userId])
  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}

model IdentityRewardReconciliation {
  id               String          @id @default(uuid()) @db.Uuid
  playerIdentityId String          @unique @db.Uuid
  userId           String          @db.Uuid
  queuedAt         DateTime        @default(now())
  completedAt      DateTime?
  attempts         Int             @default(0)
  lastError        String?         @db.VarChar(180)
  playerIdentity   PlayerIdentity  @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([completedAt, queuedAt])
  @@index([userId, completedAt])
}

model LegacyPlayerEvidence {
  id               String             @id @default(uuid()) @db.Uuid
  serverId         String             @db.Uuid
  playerIdentityId String             @db.Uuid
  gameType         GameType
  kind             LegacyEvidenceKind
  occurredAt       DateTime
  endedAt          DateTime?
  durationSeconds  Int?
  sourceKind       String             @db.VarChar(40)
  sourceLabel      String             @db.VarChar(80)
  sourceRecordHash String             @db.VarChar(64)
  importedAt       DateTime           @default(now())
  dedupeKey        String             @unique @db.VarChar(220)
  server           GameServer         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  playerIdentity   PlayerIdentity     @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)

  @@index([serverId, occurredAt])
  @@index([playerIdentityId, occurredAt])
  @@index([kind, occurredAt])
}

model UserXpEntry {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  serverEventId String?      @db.Uuid
  source        XpSource
  amount        Int
  description   String       @db.VarChar(160)
  earnedAt      DateTime     @default(now())
  dedupeKey     String       @unique @db.VarChar(220)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverEvent   ServerEvent? @relation(fields: [serverEventId], references: [id], onDelete: SetNull)

  @@index([userId, earnedAt])
  @@index([source, earnedAt])
}

model WeeklyQuestDefinition {
  id          String                 @id @default(uuid()) @db.Uuid
  slug        String                 @unique @db.VarChar(80)
  name        String                 @db.VarChar(100)
  description String                 @db.VarChar(240)
  ruleType    WeeklyQuestRuleType
  threshold   Int
  xpReward    Int
  icon        String?                @db.VarChar(40)
  enabled     Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  selections  WeeklyQuestSelection[]
}

model WeeklyQuestCycle {
  id         String                 @id @default(uuid()) @db.Uuid
  weekStart  DateTime               @unique
  endsAt     DateTime
  createdAt  DateTime               @default(now())
  selections WeeklyQuestSelection[]
}

model WeeklyQuestSelection {
  id           String                    @id @default(uuid()) @db.Uuid
  cycleId      String                    @db.Uuid
  definitionId String                    @db.Uuid
  sortOrder    Int
  cycle        WeeklyQuestCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  definition   WeeklyQuestDefinition     @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  progress     UserWeeklyQuestProgress[]

  @@unique([cycleId, definitionId])
  @@index([cycleId, sortOrder])
}

model UserWeeklyQuestProgress {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  selectionId String               @db.Uuid
  progress    Int                  @default(0)
  completedAt DateTime?
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  selection   WeeklyQuestSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@unique([userId, selectionId])
  @@index([userId, completedAt])
}

model TitleDefinition {
  id                 String              @id @default(uuid()) @db.Uuid
  slug               String              @unique
  name               String              @unique
  description        String?
  enabled            Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  userTitles         UserTitle[]
  achievementRewards AchievementReward[]
}

model UserTitle {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  titleDefinitionId String          @db.Uuid
  source            UserTitleSource
  equipped          Boolean         @default(false)
  awardedAt         DateTime        @default(now())
  awardedByUserId   String?         @db.Uuid
  user              User            @relation("TitleOwner", fields: [userId], references: [id], onDelete: Cascade)
  title             TitleDefinition @relation(fields: [titleDefinitionId], references: [id], onDelete: Cascade)
  awardedBy         User?           @relation("TitleAwarder", fields: [awardedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, titleDefinitionId])
  @@index([userId, equipped])
}

model AchievementDefinition {
  id                String              @id @default(uuid()) @db.Uuid
  slug              String              @unique
  name              String
  description       String
  secretDescription String?
  icon              String?
  gameType          GameType?
  rarity            AchievementRarity
  category          String
  ruleType          AchievementRuleType
  ruleConfig        Json
  isSecret          Boolean             @default(false)
  isRepeatable      Boolean             @default(false)
  points            Int                 @default(0)
  enabled           Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  awards            PlayerAchievement[]
  rewards           AchievementReward[]
}

model AchievementReward {
  id                      String                  @id @default(uuid()) @db.Uuid
  achievementDefinitionId String                  @db.Uuid
  kind                    AchievementRewardKind
  code                    String                  @db.VarChar(64)
  name                    String                  @db.VarChar(80)
  description             String?                 @db.VarChar(180)
  titleDefinitionId       String?                 @db.Uuid
  achievement             AchievementDefinition   @relation(fields: [achievementDefinitionId], references: [id], onDelete: Cascade)
  title                   TitleDefinition?        @relation(fields: [titleDefinitionId], references: [id], onDelete: SetNull)
  unlocks                 UserAchievementReward[]

  @@unique([achievementDefinitionId, kind, code])
  @@index([achievementDefinitionId])
}

model UserAchievementReward {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @db.Uuid
  achievementRewardId String             @db.Uuid
  playerAchievementId String?            @db.Uuid
  unlockedAt          DateTime           @default(now())
  equipped            Boolean            @default(false)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward              AchievementReward  @relation(fields: [achievementRewardId], references: [id], onDelete: Cascade)
  playerAchievement   PlayerAchievement? @relation(fields: [playerAchievementId], references: [id], onDelete: SetNull)

  @@unique([userId, achievementRewardId])
  @@index([userId, equipped])
}

model PlayerAchievement {
  id                      String                  @id @default(uuid()) @db.Uuid
  userId                  String                  @db.Uuid
  achievementDefinitionId String                  @db.Uuid
  sourceEventId           String?                 @db.Uuid
  awardedAt               DateTime                @default(now())
  dedupeKey               String                  @unique
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement             AchievementDefinition   @relation(fields: [achievementDefinitionId], references: [id], onDelete: Cascade)
  unlockedRewards         UserAchievementReward[]

  @@index([userId, awardedAt])
  @@index([achievementDefinitionId, awardedAt])
}

model UserSocialAccount {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  platform          SocialPlatform
  handle            String         @db.VarChar(80)
  profileUrl        String?        @db.VarChar(300)
  providerAccountId String?        @db.VarChar(80)
  verifiedAt        DateTime?
  displayPublic     Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@unique([platform, handle])
  @@unique([platform, providerAccountId])
  @@index([userId, displayPublic])
}

model SteamLinkNonce {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  stateHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RecordDefinition {
  id            String          @id @default(uuid()) @db.Uuid
  slug          String          @unique
  title         String
  description   String
  hall          RecordHall
  gameType      GameType?
  category      String
  valueLabel    String
  ruleType      RecordRuleType
  ruleConfig    Json
  enabled       Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  currentHolder RecordHolder?
  history       RecordHistory[]

  @@index([hall, enabled])
}

model RecordHolder {
  id                 String           @id @default(uuid()) @db.Uuid
  recordDefinitionId String           @unique @db.Uuid
  userId             String           @db.Uuid
  playerIdentityId   String           @db.Uuid
  holderName         String
  valueNumber        Int
  sourceEventId      String           @db.Uuid
  establishedAt      DateTime
  updatedAt          DateTime         @updatedAt
  definition         RecordDefinition @relation(fields: [recordDefinitionId], references: [id], onDelete: Cascade)
  user               User             @relation("RecordHolderUser", fields: [userId], references: [id], onDelete: Cascade)
  playerIdentity     PlayerIdentity   @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)
}

model RecordHistory {
  id                 String           @id @default(uuid()) @db.Uuid
  recordDefinitionId String           @db.Uuid
  userId             String           @db.Uuid
  playerIdentityId   String           @db.Uuid
  holderName         String
  valueNumber        Int
  priorValue         Int?
  priorHolderName    String?
  sourceEventId      String           @db.Uuid
  occurredAt         DateTime
  dedupeKey          String           @unique
  definition         RecordDefinition @relation(fields: [recordDefinitionId], references: [id], onDelete: Cascade)
  user               User             @relation("RecordHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  playerIdentity     PlayerIdentity   @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)

  @@index([recordDefinitionId, occurredAt])
  @@index([userId, occurredAt])
}

model ServerEvent {
  id                   String                @id @default(uuid()) @db.Uuid
  serverId             String                @db.Uuid
  gameType             GameType
  eventType            ServerEventType
  occurredAt           DateTime
  receivedAt           DateTime              @default(now())
  playerIdentityId     String?               @db.Uuid
  actorText            String?
  targetText           String?
  cause                String?
  valueNumber          Float?
  valueText            String?
  metadata             Json?
  source               String
  sourceConfidence     Int                   @default(100)
  dedupeKey            String?               @unique
  server               GameServer            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  playerIdentity       PlayerIdentity?       @relation(fields: [playerIdentityId], references: [id], onDelete: SetNull)
  reactions            ChronicleReaction[]
  discordNotifications DiscordNotification[]
  xpEntries            UserXpEntry[]

  @@index([serverId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([playerIdentityId, occurredAt])
}

model DiscordGuildConfig {
  id                         String                @id @default(uuid()) @db.Uuid
  guildId                    String                @unique
  announcementChannelId      String?
  commandsEnabled            Boolean               @default(true)
  notificationsEnabled       Boolean               @default(true)
  notifyServerOnline         Boolean               @default(true)
  notifyServerSleeping       Boolean               @default(false)
  notifyServerOutage         Boolean               @default(true)
  notifyRecordBroken         Boolean               @default(true)
  notifyLegendaryAchievement Boolean               @default(true)
  notifyWakeRequest          Boolean               @default(true)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  notifications              DiscordNotification[]
}

model WakeRequest {
  id               String            @id @default(uuid()) @db.Uuid
  serverId         String            @db.Uuid
  requesterUserId  String            @db.Uuid
  status           WakeRequestStatus @default(PENDING)
  requestedAt      DateTime          @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?           @db.Uuid
  resolutionNote   String?
  server           GameServer        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  requester        User              @relation("WakeRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  resolvedBy       User?             @relation("WakeRequestResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  votes            WakeVote[]

  @@index([serverId, status, requestedAt])
  @@index([requesterUserId, requestedAt])
}

model WakeVote {
  wakeRequestId String      @db.Uuid
  userId        String      @db.Uuid
  createdAt     DateTime    @default(now())
  wakeRequest   WakeRequest @relation(fields: [wakeRequestId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([wakeRequestId, userId])
  @@index([userId, createdAt])
}

model ServerPoll {
  id              String             @id @default(uuid()) @db.Uuid
  question        String
  status          ServerPollStatus   @default(ACTIVE)
  closesAt        DateTime
  createdByUserId String             @db.Uuid
  createdAt       DateTime           @default(now())
  closedAt        DateTime?
  creator         User               @relation("PollCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  options         ServerPollOption[]
  votes           ServerPollVote[]

  @@index([status, closesAt])
}

model ServerPollOption {
  id       String           @id @default(uuid()) @db.Uuid
  pollId   String           @db.Uuid
  serverId String           @db.Uuid
  position Int
  poll     ServerPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  server   GameServer       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  votes    ServerPollVote[]

  @@unique([pollId, serverId])
  @@unique([pollId, position])
}

model ServerPollVote {
  pollId    String           @db.Uuid
  userId    String           @db.Uuid
  optionId  String           @db.Uuid
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  poll      ServerPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    ServerPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([optionId])
}

model ServerCommand {
  id                String               @id @default(uuid()) @db.Uuid
  serverId          String               @db.Uuid
  requestedByUserId String               @db.Uuid
  action            ServerCommandAction
  status            ServerCommandStatus  @default(REQUESTED)
  requestedAt       DateTime             @default(now())
  authorizedAt      DateTime?
  dispatchedAt      DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  result            Json?
  errorCode         String?
  server            GameServer           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  requestedBy       User                 @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  audits            ServerCommandAudit[]

  @@index([status, requestedAt])
  @@index([serverId, requestedAt])
  @@index([requestedByUserId, requestedAt])
}

model ServerCommandAudit {
  id              String              @id @default(uuid()) @db.Uuid
  serverCommandId String              @db.Uuid
  status          ServerCommandStatus
  recordedAt      DateTime            @default(now())
  actorUserId     String?             @db.Uuid
  details         Json?
  command         ServerCommand       @relation(fields: [serverCommandId], references: [id], onDelete: Cascade)

  @@index([serverCommandId, recordedAt])
}

model DiscordNotification {
  id            String                  @id @default(uuid()) @db.Uuid
  configId      String                  @db.Uuid
  serverEventId String?                 @db.Uuid
  kind          DiscordNotificationKind
  content       String
  dedupeKey     String                  @unique
  queuedAt      DateTime                @default(now())
  sentAt        DateTime?
  attempts      Int                     @default(0)
  lastError     String?
  config        DiscordGuildConfig      @relation(fields: [configId], references: [id], onDelete: Cascade)
  serverEvent   ServerEvent?            @relation(fields: [serverEventId], references: [id], onDelete: SetNull)

  @@index([configId, sentAt, queuedAt])
}

model ServerPlayerPresence {
  serverId        String     @db.Uuid
  providerKey     String
  displayName     String
  present         Boolean    @default(false)
  firstObservedAt DateTime
  lastObservedAt  DateTime
  server          GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, providerKey])
  @@index([serverId, present])
}

model ChronicleReaction {
  id            String                @id @default(uuid()) @db.Uuid
  serverEventId String                @db.Uuid
  userId        String                @db.Uuid
  reactionType  ChronicleReactionType
  createdAt     DateTime              @default(now())
  serverEvent   ServerEvent           @relation(fields: [serverEventId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverEventId, userId, reactionType])
  @@index([serverEventId, reactionType])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  requestHash String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
