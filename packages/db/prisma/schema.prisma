  displayName       String
  providerKey       String
  externalProvider  SocialPlatform?
  externalAccountId String?                        @db.VarChar(80)
  verifiedAt        DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
