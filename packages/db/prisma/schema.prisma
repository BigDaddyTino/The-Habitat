  id                 String           @id @default(uuid()) @db.Uuid
  recordDefinitionId String           @unique @db.Uuid
  userId             String           @db.Uuid
  playerIdentityId   String?          @db.Uuid
  holderName         String
  valueNumber        Int
  sourceEventId      String?          @db.Uuid
  sourceActivityId   String?          @db.Uuid
  establishedAt      DateTime
  updatedAt          DateTime         @updatedAt
  definition         RecordDefinition @relation(fields: [recordDefinitionId], references: [id], onDelete: Cascade)
  user               User             @relation("RecordHolderUser", fields: [userId], references: [id], onDelete: Cascade)
  playerIdentity     PlayerIdentity?  @relation(fields: [playerIdentityId], references: [id], onDelete: SetNull)
  sourceActivity     GameActivity?    @relation("RecordHolderActivity", fields: [sourceActivityId], references: [id], onDelete: Cascade)

  @@index([sourceActivityId])
}

model RecordHistory {
  id                 String           @id @default(uuid()) @db.Uuid
  recordDefinitionId String           @db.Uuid
  userId             String           @db.Uuid
  playerIdentityId   String?          @db.Uuid
  holderName         String
  valueNumber        Int
  priorValue         Int?
  priorHolderName    String?
  sourceEventId      String?          @db.Uuid
  sourceActivityId   String?          @db.Uuid
  occurredAt         DateTime
  dedupeKey          String           @unique
  definition         RecordDefinition @relation(fields: [recordDefinitionId], references: [id], onDelete: Cascade)
  user               User             @relation("RecordHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  playerIdentity     PlayerIdentity?  @relation(fields: [playerIdentityId], references: [id], onDelete: SetNull)
  sourceActivity     GameActivity?    @relation("RecordHistoryActivity", fields: [sourceActivityId], references: [id], onDelete: Cascade)

  @@index([recordDefinitionId, occurredAt])
  @@index([userId, occurredAt])
  @@index([sourceActivityId])
}

model ServerEvent {
  id                   String                @id @default(uuid()) @db.Uuid
  serverId             String                @db.Uuid
  gameType             GameType
  eventType            ServerEventType
  occurredAt           DateTime
  receivedAt           DateTime              @default(now())
  playerIdentityId     String?               @db.Uuid
  actorText            String?
  targetText           String?
  cause                String?
  valueNumber          Float?
  valueText            String?
  metadata             Json?
  source               String
  sourceConfidence     Int                   @default(100)
  dedupeKey            String?               @unique
  server               GameServer            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  playerIdentity       PlayerIdentity?       @relation(fields: [playerIdentityId], references: [id], onDelete: SetNull)
  reactions            ChronicleReaction[]
  discordNotifications DiscordNotification[]
  xpEntries            UserXpEntry[]
  seasonXpEntries      SeasonXpEntry[]
  gameActivities       GameActivity[]

  @@index([serverId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([playerIdentityId, occurredAt])
  /// Serves the live-event feed, which every open tab polls for the arrival
  /// tail. Ordered by arrival rather than occurrence because a recovered event
  /// occurred long ago but is news the moment it lands.
  @@index([receivedAt, id])
}

model GameActivity {
  id                           String                          @id @default(uuid()) @db.Uuid
  userId                       String                          @db.Uuid
  gameKey                      String                          @db.VarChar(40)
  activityType                 String                          @db.VarChar(60)
  occurredAt                   DateTime
  source                       String                          @db.VarChar(40)
  sourceConfidence             Int                             @default(100)
  valueNumber                  Float?
  valueText                    String?                         @db.VarChar(200)
  metadata                     Json?
  sourceServerEventId          String?                         @db.Uuid
  sourceClubMatchParticipantId String?                         @db.Uuid
  providerEventId              String?                         @db.VarChar(120)
  dedupeKey                    String                          @unique @db.VarChar(220)
  chroniclePromotedAt          DateTime?
  chronicleHeadline            String?                         @db.VarChar(180)
  chronicleSummary             String?                         @db.VarChar(500)
  createdAt                    DateTime                        @default(now())
  user                         User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceServerEvent            ServerEvent?                    @relation(fields: [sourceServerEventId], references: [id], onDelete: Cascade)
  sourceClubMatchParticipant   ClubGameMatchParticipant?       @relation(fields: [sourceClubMatchParticipantId], references: [id], onDelete: Cascade)
  playerAchievements           PlayerAchievement[]
  recordHolders                RecordHolder[]                   @relation("RecordHolderActivity")
  recordHistory               RecordHistory[]                  @relation("RecordHistoryActivity")
  discordNotifications         DiscordNotification[]

  @@index([userId, activityType, occurredAt])
  @@index([gameKey, activityType, occurredAt])
  @@index([sourceServerEventId])
  @@index([sourceClubMatchParticipantId])
  @@index([chroniclePromotedAt, occurredAt])
}

model DiscordGuildConfig {
  id                         String                @id @default(uuid()) @db.Uuid
  guildId                    String                @unique
  announcementChannelId      String?
  /// Private operations channel. Habitat Pulse alerts carry infrastructure
  /// detail, so they are delivered here and never to the community
  /// announcement channel. Leaving it blank keeps operational alerting off.
  operationsChannelId        String?
  commandsEnabled            Boolean               @default(true)
  notificationsEnabled       Boolean               @default(true)
  notifyServerOnline         Boolean               @default(true)
  notifyServerSleeping       Boolean               @default(false)
  notifyServerOutage         Boolean               @default(true)
  notifyRecordBroken         Boolean               @default(true)
  notifyLegendaryAchievement Boolean               @default(true)
  notifyWakeRequest          Boolean               @default(true)
  notifyOperationalAlert     Boolean               @default(true)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  notifications              DiscordNotification[]
}

/// Hand-written SQL constraint (migration 20260810213126_add_wake_requests_and_polls):
/// partial unique index "WakeRequest_one_pending_per_server" ON ("serverId") WHERE "status" = 'PENDING'.
/// It exists only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop it.
model WakeRequest {
  id               String            @id @default(uuid()) @db.Uuid
  serverId         String            @db.Uuid
  requesterUserId  String            @db.Uuid
  status           WakeRequestStatus @default(PENDING)
  requestedAt      DateTime          @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?           @db.Uuid
  resolutionNote   String?
  server           GameServer        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  requester        User              @relation("WakeRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  resolvedBy       User?             @relation("WakeRequestResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  votes            WakeVote[]

  @@index([serverId, status, requestedAt])
  @@index([requesterUserId, requestedAt])
}

model WakeVote {
  wakeRequestId String      @db.Uuid
  userId        String      @db.Uuid
  createdAt     DateTime    @default(now())
  wakeRequest   WakeRequest @relation(fields: [wakeRequestId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([wakeRequestId, userId])
  @@index([userId, createdAt])
}

/// Hand-written SQL constraint (migration 20260810213126_add_wake_requests_and_polls):
/// partial unique index "ServerPoll_one_active" ON ((1)) WHERE "status" = 'ACTIVE' — at most one active poll.
/// It exists only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop it.
model ServerPoll {
  id              String             @id @default(uuid()) @db.Uuid
  question        String
  status          ServerPollStatus   @default(ACTIVE)
  closesAt        DateTime
  createdByUserId String             @db.Uuid
  createdAt       DateTime           @default(now())
  closedAt        DateTime?
  creator         User               @relation("PollCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  options         ServerPollOption[]
  votes           ServerPollVote[]

  @@index([status, closesAt])
}

model ServerPollOption {
  id       String           @id @default(uuid()) @db.Uuid
  pollId   String           @db.Uuid
  serverId String           @db.Uuid
  position Int
  poll     ServerPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  server   GameServer       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  votes    ServerPollVote[]

  @@unique([pollId, serverId])
  @@unique([pollId, position])
}

model ServerPollVote {
  pollId    String           @db.Uuid
  userId    String           @db.Uuid
  optionId  String           @db.Uuid
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  poll      ServerPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    ServerPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([optionId])
}

model ServerCommand {
  id                String               @id @default(uuid()) @db.Uuid
  serverId          String               @db.Uuid
  requestedByUserId String               @db.Uuid
  action            ServerCommandAction
  status            ServerCommandStatus  @default(REQUESTED)
  requestedAt       DateTime             @default(now())
  authorizedAt      DateTime?
  dispatchedAt      DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  result            Json?
  errorCode         String?
  server            GameServer           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  requestedBy       User                 @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  audits            ServerCommandAudit[]

  @@index([status, requestedAt])
  @@index([serverId, requestedAt])
  @@index([requestedByUserId, requestedAt])
}

model ServerCommandAudit {
  id              String              @id @default(uuid()) @db.Uuid
  serverCommandId String              @db.Uuid
  status          ServerCommandStatus
  recordedAt      DateTime            @default(now())
  actorUserId     String?             @db.Uuid
  details         Json?
  command         ServerCommand       @relation(fields: [serverCommandId], references: [id], onDelete: Cascade)

  @@index([serverCommandId, recordedAt])
}

model DiscordNotification {
  id            String                  @id @default(uuid()) @db.Uuid
  configId      String                  @db.Uuid
  serverEventId String?                 @db.Uuid
  gameActivityId String?                @db.Uuid
  kind          DiscordNotificationKind
  /// Explicit delivery target captured when the notification was queued. Null
  /// means the guild's announcement channel. Operational alerts always carry
  /// their own operations channel so a later configuration change can never
  /// redirect infrastructure detail into a community channel.
  channelId     String?                 @db.VarChar(40)
  content       String
  dedupeKey     String                  @unique
  queuedAt      DateTime                @default(now())
  sentAt        DateTime?
  attempts      Int                     @default(0)
  lastError     String?
  config        DiscordGuildConfig      @relation(fields: [configId], references: [id], onDelete: Cascade)
  serverEvent   ServerEvent?            @relation(fields: [serverEventId], references: [id], onDelete: SetNull)
  gameActivity  GameActivity?           @relation(fields: [gameActivityId], references: [id], onDelete: Cascade)

  @@index([configId, sentAt, queuedAt])
  @@index([gameActivityId])
}

model ServerPlayerPresence {
  serverId        String     @db.Uuid
  providerKey     String
  displayName     String
  present         Boolean    @default(false)
  firstObservedAt DateTime
  lastObservedAt  DateTime
  server          GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, providerKey])
  @@index([serverId, present])
}

model ChronicleReaction {
  id            String                @id @default(uuid()) @db.Uuid
  serverEventId String                @db.Uuid
  userId        String                @db.Uuid
  reactionType  ChronicleReactionType
  createdAt     DateTime              @default(now())
  serverEvent   ServerEvent           @relation(fields: [serverEventId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverEventId, userId, reactionType])
  @@index([serverEventId, reactionType])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  requestHash String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

// ---------------------------------------------------------------------------
// Operational observability (Habitat Pulse)
//
// Everything below records how the installation itself is behaving. None of it
// is member-facing: the Pulse view is an administrator surface, and the rows
// here deliberately hold no infrastructure addresses or secrets.
// ---------------------------------------------------------------------------

/// One row per long-running Habitat process. The row is upserted on a fixed
/// cadence, so freshness — not the value of any field — is what proves the
/// service is alive. `intervalMs` is stored with the beat so a reader can judge
/// staleness against the writer's own cadence instead of a guessed constant.
///
/// Database-enforced in migration 20260813200000 and NOT expressible here:
/// CHECK "ServiceHeartbeat_interval_is_sane".
model ServiceHeartbeat {
  service    HabitatService @id
  instanceId String         @db.VarChar(80)
  hostname   String         @db.VarChar(120)
  version    String         @db.VarChar(40)
  startedAt  DateTime
  observedAt DateTime
  intervalMs Int
  detail     Json?
  updatedAt  DateTime       @updatedAt
}

/// The evaluated state of a single Pulse signal, written by the worker each
/// cycle and read by the admin view. Storing the evaluation (rather than
/// recomputing it in the page) keeps what administrators see and what Discord
/// was told about in permanent agreement.
///
/// Database-enforced in migration 20260813200000 and NOT expressible here:
/// CHECK "PulseSignal_ok_has_last_ok_at" — a signal reporting OK must carry the
/// timestamp of that OK observation, so a green tile can never be undated.
model PulseSignal {
  key            String       @id @db.VarChar(60)
  category       PulseCategory
  status         PulseStatus
  summary        String       @db.VarChar(240)
  detail         Json?
  observedAt     DateTime
  /// When the current status was first observed. Reset only on a real change,
  /// so "critical for 3 hours" is distinguishable from "critical since the last
  /// cycle".
  statusSince    DateTime
  lastOkAt       DateTime?
  notifiedStatus PulseStatus?
  notifiedAt     DateTime?
  updatedAt      DateTime     @updatedAt

  @@index([status, observedAt])
}

/// Per-world, per-source collector health. A source that is readable but parses
/// nothing is a distinct and more dangerous failure than one that is missing,
/// so both the scan outcome and the record yield are recorded.
///
/// Database-enforced in migration 20260813200000 and NOT expressible here:
/// CHECK "CollectorSourceState_counts_nonnegative" and
/// CHECK "CollectorSourceState_unavailable_yields_nothing".
model CollectorSourceState {
  serverId        String     @db.Uuid
  sourceKind      String     @db.VarChar(60)
  label           String     @db.VarChar(120)
  available       Boolean    @default(false)
  truncated       Boolean    @default(false)
  lastScanAt      DateTime
  /// Newest scan that both read the source and parsed at least one record.
  lastYieldAt     DateTime?
  /// `occurredAt` of the newest record the source has ever yielded.
  lastRecordAt    DateTime?
  recordsLastScan Int        @default(0)
  importedLastScan Int       @default(0)
  lastError       String?    @db.VarChar(240)
  server          GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, sourceKind])
  @@index([lastScanAt])
}

/// A reward pipeline evaluation that threw. These used to abort an entire
/// import cycle silently; recording them lets one poisoned record be skipped
/// and still be visible, replayable, and countable on the Pulse view.
model EvaluationFailure {
  id         String   @id @default(uuid()) @db.Uuid
  kind       String   @db.VarChar(40)
  scope      String   @db.VarChar(120)
  reference  String?  @db.VarChar(200)
  message    String   @db.VarChar(300)
  occurredAt DateTime @default(now())
  resolvedAt DateTime?

  @@index([occurredAt])
  @@index([kind, resolvedAt, occurredAt])
}
