model PlayerIdentityClaim {
  id               String                         @id @default(uuid()) @db.Uuid
  playerIdentityId String                         @db.Uuid
  userId           String                         @db.Uuid
  status           IdentityClaimStatus            @default(PENDING)
  requestedAt      DateTime                       @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?                        @db.Uuid
  resolutionNote   String?
  playerIdentity   PlayerIdentity                 @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)
  user             User                           @relation("IdentityClaimant", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy       User?                          @relation("IdentityClaimResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  ownershipLedger  IdentityOwnershipTransaction[]

  @@unique([playerIdentityId, userId])
  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}

model IdentityRewardReconciliation {
  id               String         @id @default(uuid()) @db.Uuid
  playerIdentityId String         @unique @db.Uuid
  userId           String         @db.Uuid
  queuedAt         DateTime       @default(now())
  completedAt      DateTime?
  attempts         Int            @default(0)
  lastError        String?        @db.VarChar(180)
  playerIdentity   PlayerIdentity @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([completedAt, queuedAt])
  @@index([userId, completedAt])
}

/// Append-only ownership ledger for `PlayerIdentity`. Every transition of
/// `PlayerIdentity.userId` — granted by claim approval, by Steam proof, by the
/// worker's auto-link, or revoked by an administrator — writes exactly one row
/// here, inside the same transaction as the change itself.
///
/// This is what makes a claim reversible. `projectedImpact` stores the preview
/// an administrator was shown before confirming, and `appliedImpact` stores
/// what the reversal actually removed, so the two can be compared afterwards.
/// A REVOKE points at the GRANT it reverses through `reversalTransactionId`;
/// that GRANT is marked `REVERSED` in the same database transaction.
///
/// Database-enforced in migration 20260814120000 and NOT expressible here:
/// CHECK "IdentityOwnershipTransaction_direction" — a GRANT must carry a
/// `toUserId` and a REVOKE must carry a `fromUserId`.
model IdentityOwnershipTransaction {
  id                    String                        @id @default(uuid()) @db.Uuid
  playerIdentityId      String                        @db.Uuid
  action                IdentityOwnershipAction
  status                IdentityOwnershipStatus       @default(APPLIED)
  source                IdentityOwnershipSource
  fromUserId            String?                       @db.Uuid
  toUserId              String?                       @db.Uuid
  claimId               String?                       @db.Uuid
  actorUserId           String?                       @db.Uuid
  reason                String?                       @db.VarChar(300)
  projectedImpact       Json?
  appliedImpact         Json?
  reversalTransactionId String?                       @unique @db.Uuid
  reversedAt            DateTime?
  createdAt             DateTime                      @default(now())
  playerIdentity        PlayerIdentity                @relation(fields: [playerIdentityId], references: [id], onDelete: Restrict)
  fromUser              User?                         @relation("IdentityOwnershipFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser                User?                         @relation("IdentityOwnershipTo", fields: [toUserId], references: [id], onDelete: SetNull)
  actor                 User?                         @relation("IdentityOwnershipActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  claim                 PlayerIdentityClaim?          @relation(fields: [claimId], references: [id], onDelete: SetNull)
  reversalOf            IdentityOwnershipTransaction? @relation("IdentityOwnershipReversal", fields: [reversalTransactionId], references: [id], onDelete: SetNull)
  reversedBy            IdentityOwnershipTransaction? @relation("IdentityOwnershipReversal")

  @@index([playerIdentityId, createdAt])
  @@index([toUserId, createdAt])
  @@index([fromUserId, createdAt])
  @@index([action, status, createdAt])
}

model LegacyPlayerEvidence {
  id               String             @id @default(uuid()) @db.Uuid
  serverId         String             @db.Uuid
  playerIdentityId String             @db.Uuid
  gameType         GameType
  kind             LegacyEvidenceKind
  occurredAt       DateTime
