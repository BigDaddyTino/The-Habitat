// ---------------------------------------------------------------------------
// Operational observability (Habitat Pulse)
//
// Everything below records how the installation itself is behaving. None of it
// is member-facing: the Pulse view is an administrator surface, and the rows
// here deliberately hold no infrastructure addresses or secrets.
// ---------------------------------------------------------------------------

/// One row per long-running Habitat process. The row is upserted on a fixed
/// cadence, so freshness — not the value of any field — is what proves the
/// service is alive. `intervalMs` is stored with the beat so a reader can judge
/// staleness against the writer's own cadence instead of a guessed constant.
///
/// Database-enforced in migration 20260813200000 and NOT expressible here:
/// CHECK "ServiceHeartbeat_interval_is_sane".
model ServiceHeartbeat {
  service    HabitatService @id
  instanceId String         @db.VarChar(80)
  hostname   String         @db.VarChar(120)
  version    String         @db.VarChar(40)
  startedAt  DateTime
  observedAt DateTime
  intervalMs Int
  detail     Json?
  updatedAt  DateTime       @updatedAt
}

/// The evaluated state of a single Pulse signal, written by the worker each
/// cycle and read by the admin view. Storing the evaluation (rather than
/// recomputing it in the page) keeps what administrators see and what Discord
/// was told about in permanent agreement.
///
/// Database-enforced in migration 20260813200000 and NOT expressible here:
/// CHECK "PulseSignal_ok_has_last_ok_at" — a signal reporting OK must carry the
/// timestamp of that OK observation, so a green tile can never be undated.
model PulseSignal {
  key            String        @id @db.VarChar(60)
  category       PulseCategory
  status         PulseStatus
  summary        String        @db.VarChar(240)
  detail         Json?
  observedAt     DateTime
  /// When the current status was first observed. Reset only on a real change,
  /// so "critical for 3 hours" is distinguishable from "critical since the last
  /// cycle".
  statusSince    DateTime
  lastOkAt       DateTime?
  notifiedStatus PulseStatus?
  notifiedAt     DateTime?
  updatedAt      DateTime      @updatedAt

  @@index([status, observedAt])
}

/// Per-world, per-source collector health. A source that is readable but parses
/// nothing is a distinct and more dangerous failure than one that is missing,
/// so both the scan outcome and the record yield are recorded.
///
/// Database-enforced in migration 20260813200000 and NOT expressible here:
/// CHECK "CollectorSourceState_counts_nonnegative" and
/// CHECK "CollectorSourceState_unavailable_yields_nothing".
model CollectorSourceState {
  serverId         String     @db.Uuid
  sourceKind       String     @db.VarChar(60)
  label            String     @db.VarChar(120)
  available        Boolean    @default(false)
  truncated        Boolean    @default(false)
  lastScanAt       DateTime
  /// Newest scan that both read the source and parsed at least one record.
  lastYieldAt      DateTime?
  /// `occurredAt` of the newest record the source has ever yielded.
  lastRecordAt     DateTime?
  recordsLastScan  Int        @default(0)
  importedLastScan Int        @default(0)
  lastError        String?    @db.VarChar(240)
  server           GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, sourceKind])
  @@index([lastScanAt])
}

/// A reward pipeline evaluation that threw. These used to abort an entire
/// import cycle silently; recording them lets one poisoned record be skipped
/// and still be visible, replayable, and countable on the Pulse view.
model EvaluationFailure {
  id         String    @id @default(uuid()) @db.Uuid
  kind       String    @db.VarChar(40)
  scope      String    @db.VarChar(120)
  reference  String?   @db.VarChar(200)
  message    String    @db.VarChar(300)
  occurredAt DateTime  @default(now())
  resolvedAt DateTime?

  @@index([occurredAt])
  @@index([kind, resolvedAt, occurredAt])
}

/// A chapter of the mainline or a self-contained side quest — the unit a board
/// is drawn for. Side quests get their own arc so a contributor can build one
/// out without touching the spine of the story.
model StoryArc {
  id                String                  @id @default(uuid()) @db.Uuid
  slug              String                  @unique @db.VarChar(64)
  title             String                  @db.VarChar(120)
  summary           String?                 @db.VarChar(500)
  /// How the party finds this quest — notice board, dying stranger, a rumor
  /// in a tavern. Free-text roleplay intent; the region below is the
  /// structural half.
  hook              String?                 @db.VarChar(500)
  /// Where the quest is picked up, as a REGION bible entry so the pickup
  /// place always resolves to a real asset on the game side.
  regionEntryId     String?                 @db.Uuid
  isMainline        Boolean                 @default(false)
  /// The filing category, kept in lockstep with `isMainline` by a CHECK
  /// constraint — see the enum for why both columns exist.
  category          StoryArcCategory        @default(SIDE_QUEST)
  /// Whose story this is when the category is COMPANION_QUEST — a CHARACTER
  /// bible entry, so the companion always resolves to a real dossier. Mirrors
  /// `regionEntryId` exactly.
  companionEntryId  String?                 @db.Uuid
  /// Whose banner this quest flies when the category is FACTION_QUEST — a
  /// FACTION bible entry, so the faction always resolves to a real dossier.
  /// Mirrors `companionEntryId` exactly.
  factionEntryId    String?                 @db.Uuid
  status            StoryStatus             @default(PROPOSED)
  position          Int                     @default(0)
  /// The writers' room is open by default: nothing is frozen until somebody
  /// freezes it. A locked arc is settled story — no card, branch, or arc
  /// setting on it can be changed by anyone, including the admin who locked
  /// it, until it is unlocked again. Only an ADMIN may turn it either way.
  ///
  /// This is NOT the courtesy lock that `StoryNode.lockedByUserId` carries.
  /// That one is transient, self-expiring, and only says "someone is typing
  /// here"; this one is a deliberate, permanent-until-lifted freeze, so it
  /// has no expiry and is never claimed automatically.
  lockedAt          DateTime?
  lockedByUserId    String?                 @db.Uuid
  createdByUserId   String                  @db.Uuid
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  creator           User                    @relation("StoryArcCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  lockedBy          User?                   @relation("StoryArcLock", fields: [lockedByUserId], references: [id], onDelete: SetNull)
  region            StoryEntry?             @relation("StoryArcRegion", fields: [regionEntryId], references: [id], onDelete: SetNull)
  companion         StoryEntry?             @relation("StoryArcCompanion", fields: [companionEntryId], references: [id], onDelete: SetNull)
  faction           StoryEntry?             @relation("StoryArcFaction", fields: [factionEntryId], references: [id], onDelete: SetNull)
  nodes             StoryNode[]
  edges             StoryEdge[]
  continuedFrom     StoryNode[]             @relation("StoryContinuation")
  presence          StoryPresence[]
  assistantMessages StoryAssistantMessage[]

  @@index([status, isMainline, position])
  @@index([category, position])
}

/// One beat, scene, choice, or ending on a board.
///
/// `key` is the handle the Unreal importer addresses this node by, so it is
/// stable across retitling — renaming a scene in the web editor must not orphan
/// the asset it already generated.
///
/// `version` backs optimistic concurrency: an edit carrying a stale version is
/// refused rather than silently overwriting whoever saved first. `lockedByUserId`
/// is only a courtesy signal on top of that, and `lockExpiresAt` bounds it —
/// a closed laptop must not freeze a node for everyone else forever.
///
/// The migration additionally CHECKs that canvas coordinates stay within
/// +/-100000 and that a CANON node carries a non-empty title.
model StoryNode {
  id                String                  @id @default(uuid()) @db.Uuid
  arcId             String                  @db.Uuid
  kind              StoryNodeKind           @default(SCENE)
  key               String                  @db.VarChar(80)
  title             String                  @db.VarChar(160)
  summary           String?                 @db.VarChar(500)
  body              String?                 @db.Text
  status            StoryStatus             @default(PROPOSED)
  /// Who speaks this node, when it is one voice. A reference to a CHARACTER
  /// bible entry rather than free text, so a speaker can never be a typo and
  /// always resolves to an asset the importer knows. Null is unattributed
  /// narration — the correct value for most SCENE and BEAT nodes, whose bodies
  /// carry multi-speaker attribution inline.
  speakerEntryId    String?                 @db.Uuid
  /// Only meaningful on ENDING nodes; the migration CHECKs that pairing.
  endingKind        StoryEndingKind?
  /// What finishes this step, as writer intent in free text — only meaningful
  /// on QUEST_STEP nodes (CHECKed). An Unreal author transcribes it into a
  /// real task; it is documentation for a human, never parsed by a machine.
  completion        String?                 @db.VarChar(500)
  /// What the story does here — give item, set flag, shift reputation — as
  /// free-text lines. Interpreted by the game, never by the codex.
  effects           String[]                @default([])
  /// What finishing this pays, one reward per line. Kept apart from effects
  /// so payment reads at a glance; notable rewards should also exist as ITEM
  /// entries referenced on the node.
  rewards           String[]                @default([])
  /// Where an ENDING flows next (CHECKed to endings) — the structural link
  /// that chains multi-part quests and joins the prologue to its branches.
  continuesInArcId  String?                 @db.Uuid
  canvasX           Int                     @default(0)
  canvasY           Int                     @default(0)
  version           Int                     @default(1)
  createdByUserId   String                  @db.Uuid
  updatedByUserId   String?                 @db.Uuid
  lockedByUserId    String?                 @db.Uuid
  lockExpiresAt     DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  arc               StoryArc                @relation(fields: [arcId], references: [id], onDelete: Cascade)
  creator           User                    @relation("StoryNodeCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  editor            User?                   @relation("StoryNodeEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  lockedBy          User?                   @relation("StoryNodeLock", fields: [lockedByUserId], references: [id], onDelete: SetNull)
  speaker           StoryEntry?             @relation("StoryNodeSpeaker", fields: [speakerEntryId], references: [id], onDelete: SetNull)
  continuesIn       StoryArc?               @relation("StoryContinuation", fields: [continuesInArcId], references: [id], onDelete: SetNull)
  outgoingEdges     StoryEdge[]             @relation("StoryEdgeFrom")
  incomingEdges     StoryEdge[]             @relation("StoryEdgeTo")
  lines             StoryLine[]
  entryLinks        StoryEntryLink[]
  comments          StoryComment[]
  presence          StoryPresence[]
  assistantMessages StoryAssistantMessage[]
  mapPlacements     StoryMapNodePlacement[]

  @@unique([arcId, key])
  @@index([arcId, status])
  @@index([status, updatedAt])
}

/// A transition between two nodes. `label` is the choice text the player sees,
/// so an unlabelled edge is a straight continuation rather than a decision.
///
/// The migration CHECKs that an edge never points at its own source. Both ends
/// living in the same arc is enforced in the server action rather than by a
/// composite foreign key, because a two-relation composite FK through `arcId`
/// would need Prisma to own the same column from two sides.
model StoryEdge {
  id              String      @id @default(uuid()) @db.Uuid
  arcId           String      @db.Uuid
  /// The stable handle the Unreal importer names a synthesised choice asset
  /// by. Minted at creation, unique inside the arc, and never derived from
  /// the label, the target, or the order — all three are things a writer
  /// legitimately changes without meaning to orphan a game asset. The
  /// database default is a deployment bridge for builds older than the
  /// column; the server action always mints a readable key explicitly.
  key             String      @default(dbgenerated("('choice-'::text || substr(md5((gen_random_uuid())::text), 1, 12))")) @db.VarChar(80)
  fromNodeId      String      @db.Uuid
  toNodeId        String      @db.Uuid
  label           String?     @db.VarChar(200)
  condition       String?     @db.VarChar(300)
  /// What choosing this branch does, as free-text lines the game interprets.
  effects         String[]    @default([])
  position        Int         @default(0)
  /// Only meaningful on a labelled edge out of a CHOICE node: whether the
  /// option text is a spoken player line the voice pipeline should render.
  voiced          Boolean     @default(false)
  status          StoryStatus @default(PROPOSED)
  createdByUserId String      @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  arc             StoryArc    @relation(fields: [arcId], references: [id], onDelete: Cascade)
  fromNode        StoryNode   @relation("StoryEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode          StoryNode   @relation("StoryEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  creator         User        @relation("StoryEdgeCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([arcId, key])
  @@unique([fromNodeId, position])
  @@index([arcId, status])
  @@index([toNodeId])
}

/// A lore bible entry: the theme, regions, creatures, characters, factions,
/// items, and rules a writer has to know before adding to the story.
model StoryEntry {
  id                   String                 @id @default(uuid()) @db.Uuid
  kind                 StoryEntryKind
  slug                 String                 @unique @db.VarChar(64)
  title                String                 @db.VarChar(120)
  summary              String?                @db.VarChar(500)
  body                 String?                @db.Text
  /// The typed module object from Codex_Module_Schema.md — shape depends on
  /// kind, every field nullable, null meaning "not yet decided". Prose stays
  /// primary; meta is the queryable index over it.
  meta                 Json?
  status               StoryStatus            @default(PROPOSED)
  version              Int                    @default(1)
  createdByUserId      String                 @db.Uuid
  updatedByUserId      String?                @db.Uuid
  lockedByUserId       String?                @db.Uuid
  lockExpiresAt        DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  creator              User                   @relation("StoryEntryCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  editor               User?                  @relation("StoryEntryEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  lockedBy             User?                  @relation("StoryEntryLock", fields: [lockedByUserId], references: [id], onDelete: SetNull)
  nodeLinks            StoryEntryLink[]
  comments             StoryComment[]
  speakerOf            StoryNode[]            @relation("StoryNodeSpeaker")
  spokenLines          StoryLine[]            @relation("StoryLineSpeaker")
  heardLines           StoryLine[]            @relation("StoryLineListener")
  regionOf             StoryArc[]             @relation("StoryArcRegion")
  companionOf          StoryArc[]             @relation("StoryArcCompanion")
  factionOf            StoryArc[]             @relation("StoryArcFaction")
  ownedMap             StoryMap?              @relation("StoryMapOwner")
  mapPlacements        StoryMapPlacement[]
  worldConnectionsFrom StoryWorldConnection[] @relation("StoryWorldConnectionFrom")
  worldConnectionsTo   StoryWorldConnection[] @relation("StoryWorldConnectionTo")
  contributions        StoryEntryContribution[]

  @@index([kind, status, title])
  @@index([status, updatedAt])
}

/// A contributor's original submission, kept whole, under their own name.
///
/// When a member writes something the codex then builds on, the rewrite
/// replaces `StoryEntry.body` and their words would otherwise be gone. This
/// table keeps the original verbatim and the dossier renders it at the foot of
/// the page in a gold-bordered card credited to them.
///
/// **It is never exported.** The guarantee is structural rather than a filter:
/// the outbound bundle's entry mapper in apps/codex-sync/src/snapshot.ts is an
/// explicit allowlist of StoryEntry columns, so a separate table cannot reach
/// it. Storing this in `body` or `meta` would ship it to the game; a table
/// cannot. scripts/audit-contributions.ts asserts that again against a built
/// snapshot.
model StoryEntryContribution {
  id                 String     @id @default(uuid()) @db.Uuid
  entryId            String     @db.Uuid
  contributorUserId  String     @db.Uuid
  /// What this submission was, in the contributor's frame — "Original faction
  /// dossier", "Original character brief". Shown as the card's subtitle.
  label              String     @db.VarChar(160)
  /// The submission exactly as written. Never edited, never tidied, never
  /// spell-checked. A correction to a contributor's own words is a new row.
  body               String     @db.Text
  /// Display order when one entry carries more than one submission.
  position           Int        @default(0)
  /// When they wrote it, which is usually not when this row was created.
  submittedAt        DateTime
  createdByUserId    String     @db.Uuid
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  entry              StoryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  contributor        User       @relation("StoryContributionAuthor", fields: [contributorUserId], references: [id], onDelete: Restrict)
  creator            User       @relation("StoryContributionCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([entryId, position])
  @@index([contributorUserId])
}

/// One zoomable illustrated atlas scene. A world map can own child region or
/// settlement maps without coupling their art pixels to Unreal coordinates.
model StoryMap {
  id               String                   @id @default(uuid()) @db.Uuid
  slug             String                   @unique @db.VarChar(64)
  title            String                   @db.VarChar(120)
  parentMapId      String?                  @db.Uuid
  ownerEntryId     String?                  @unique @db.Uuid
  artVersion       String                   @db.VarChar(40)
  imageWidth       Int
  imageHeight      Int
  coordinateWidth  Int                      @default(100000)
  coordinateHeight Int
  initialCenterX   Int
  initialCenterY   Int
  initialZoom      Float                    @default(0)
  minZoom          Float                    @default(0)
  maxZoom          Float                    @default(8)
  version          Int                      @default(1)
  createdByUserId  String                   @db.Uuid
  updatedByUserId  String?                  @db.Uuid
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  parent           StoryMap?                @relation("StoryMapHierarchy", fields: [parentMapId], references: [id], onDelete: SetNull)
  children         StoryMap[]               @relation("StoryMapHierarchy")
  owner            StoryEntry?              @relation("StoryMapOwner", fields: [ownerEntryId], references: [id], onDelete: SetNull)
  placements       StoryMapPlacement[]
  nodePlacements   StoryMapNodePlacement[]
  topologyNodes    StoryMapTopologyNode[]
  boundaries       StoryMapBoundary[]
  connectionPaths  StoryMapConnectionPath[]
  creator          User                     @relation("StoryMapCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  editor           User?                    @relation("StoryMapEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([parentMapId, title])
  @@index([ownerEntryId])
}

/// A quest beat's exact authored position on an atlas scene. Keeping node
/// markers separate from place placements allows two steps in one city to land
/// at different coordinates without inventing duplicate Codex locations.
model StoryMapNodePlacement {
  id              String               @id @default(uuid()) @db.Uuid
  mapId           String               @db.Uuid
  nodeId          String               @db.Uuid
  geometryKind    StoryMapGeometryKind
  geometry        Json
  labelX          Int?
  labelY          Int?
  minZoom         Float                @default(0)
  maxZoom         Float?
  priority        Int                  @default(0)
  version         Int                  @default(1)
  createdByUserId String               @db.Uuid
  updatedByUserId String?              @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  map             StoryMap             @relation(fields: [mapId], references: [id], onDelete: Cascade)
  node            StoryNode            @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  creator         User                 @relation("StoryMapNodePlacementCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  editor          User?                @relation("StoryMapNodePlacementEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([mapId, nodeId])
  @@index([mapId, priority])
  @@index([nodeId])
}

/// A Codex entry's authored position on one atlas scene. Lore remains on the
/// entry; this record only owns cartographic presentation and zoom behavior.
model StoryMapPlacement {
  id              String               @id @default(uuid()) @db.Uuid
  mapId           String               @db.Uuid
  entryId         String               @db.Uuid
  geometryKind    StoryMapGeometryKind
  geometry        Json
  labelX          Int?
  labelY          Int?
  minZoom         Float                @default(0)
  maxZoom         Float?
  priority        Int                  @default(0)
  version         Int                  @default(1)
  createdByUserId String               @db.Uuid
  updatedByUserId String?              @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  map             StoryMap             @relation(fields: [mapId], references: [id], onDelete: Cascade)
  entry           StoryEntry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  creator         User                 @relation("StoryMapPlacementCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  editor          User?                @relation("StoryMapPlacementEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  areaRings       StoryMapAreaRing[]

  @@unique([mapId, entryId])
  @@index([mapId, priority])
  @@index([entryId])
}

/// One canonical shared-topology vertex in a map's fixed-point extent. Exact
/// coordinate uniqueness makes a junction one node rather than several
/// coincident nodes; independent analytical overlays do not use this table.
model StoryMapTopologyNode {
  id              String             @id @default(uuid()) @db.Uuid
  mapId           String             @db.Uuid
  x               Int
  y               Int
  version         Int                @default(1)
  createdByUserId String             @db.Uuid
  updatedByUserId String?            @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  map             StoryMap           @relation(fields: [mapId], references: [id], onDelete: Restrict)
  boundariesFrom  StoryMapBoundary[] @relation("StoryMapBoundaryStart")
  boundariesTo    StoryMapBoundary[] @relation("StoryMapBoundaryEnd")
  creator         User               @relation("StoryMapTopologyNodeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  editor          User?              @relation("StoryMapTopologyNodeEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([mapId, x, y])
  @@index([mapId])
}

/// A shared base-geography edge. Endpoints live on topology nodes; this JSON
/// stores only the bounded ordered interior fixed-point vertices.
model StoryMapBoundary {
  id               String                     @id @default(uuid()) @db.Uuid
  mapId            String                     @db.Uuid
  startNodeId      String                     @db.Uuid
  endNodeId        String                     @db.Uuid
  kind             StoryMapBoundaryKind
  interiorVertices Json
  version          Int                        @default(1)
  createdByUserId  String                     @db.Uuid
  updatedByUserId  String?                    @db.Uuid
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  map              StoryMap                   @relation(fields: [mapId], references: [id], onDelete: Restrict)
  startNode        StoryMapTopologyNode       @relation("StoryMapBoundaryStart", fields: [startNodeId], references: [id], onDelete: Restrict)
  endNode          StoryMapTopologyNode       @relation("StoryMapBoundaryEnd", fields: [endNodeId], references: [id], onDelete: Restrict)
  ringReferences   StoryMapAreaRingBoundary[]
  creator          User                       @relation("StoryMapBoundaryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  editor           User?                      @relation("StoryMapBoundaryEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([mapId])
  @@index([startNodeId])
  @@index([endNodeId])
}

/// One shell or hole in a topology-backed placement component. `ringIndex=0`
/// is the component shell; positive indexes are independently ordered holes.
model StoryMapAreaRing {
  id              String                     @id @default(uuid()) @db.Uuid
  placementId     String                     @db.Uuid
  componentIndex  Int
  ringIndex       Int
  role            StoryMapAreaRingRole
  version         Int                        @default(1)
  createdByUserId String                     @db.Uuid
  updatedByUserId String?                    @db.Uuid
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  placement       StoryMapPlacement          @relation(fields: [placementId], references: [id], onDelete: Restrict)
  boundaries      StoryMapAreaRingBoundary[]
  creator         User                       @relation("StoryMapAreaRingCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  editor          User?                      @relation("StoryMapAreaRingEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([placementId, componentIndex, ringIndex])
  @@index([placementId])
}

/// Ordered consumption of one shared boundary by one area ring. The compound
/// primary key prevents duplicate boundary use while `sequence` fixes order.
model StoryMapAreaRingBoundary {
  ringId     String           @db.Uuid
  boundaryId String           @db.Uuid
  sequence   Int
  reversed   Boolean          @default(false)
  ring       StoryMapAreaRing @relation(fields: [ringId], references: [id], onDelete: Restrict)
  boundary   StoryMapBoundary @relation(fields: [boundaryId], references: [id], onDelete: Restrict)

  @@id([ringId, boundaryId])
  @@unique([ringId, sequence])
  @@index([boundaryId])
}

/// A stable first-class route or world relationship between canonical Codex
/// entries. Multiple rows between the same endpoints are intentionally valid.
model StoryWorldConnection {
  id              String                             @id @default(uuid()) @db.Uuid
  fromEntryId     String                             @db.Uuid
  toEntryId       String                             @db.Uuid
  type            StoryWorldConnectionType
  directionality  StoryWorldConnectionDirectionality @default(UNSPECIFIED)
  status          StoryWorldConnectionStatus         @default(UNSPECIFIED)
  visibility      StoryWorldConnectionVisibility     @default(DEFAULT)
  originalWording String?                            @db.VarChar(2000)
  editorialNotes  String?                            @db.VarChar(2000)
  metadata        Json
  version         Int                                @default(1)
  createdByUserId String                             @db.Uuid
  updatedByUserId String?                            @db.Uuid
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt
  fromEntry       StoryEntry                         @relation("StoryWorldConnectionFrom", fields: [fromEntryId], references: [id], onDelete: Restrict)
  toEntry         StoryEntry                         @relation("StoryWorldConnectionTo", fields: [toEntryId], references: [id], onDelete: Restrict)
  paths           StoryMapConnectionPath[]
  creator         User                               @relation("StoryWorldConnectionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  editor          User?                              @relation("StoryWorldConnectionEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([fromEntryId])
  @@index([toEntryId])
  @@index([type])
}

/// One connection's cartographic representation in one scene. Disconnected
/// route pieces use MULTILINESTRING rather than competing per-scene rows.
model StoryMapConnectionPath {
  id              String                             @id @default(uuid()) @db.Uuid
  connectionId    String                             @db.Uuid
  mapId           String                             @db.Uuid
  geometryKind    StoryMapConnectionPathGeometryKind
  geometry        Json
  minZoom         Float                              @default(0)
  maxZoom         Float?
  priority        Int                                @default(0)
  version         Int                                @default(1)
  createdByUserId String                             @db.Uuid
  updatedByUserId String?                            @db.Uuid
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt
  connection      StoryWorldConnection               @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  map             StoryMap                           @relation(fields: [mapId], references: [id], onDelete: Restrict)
  creator         User                               @relation("StoryMapConnectionPathCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  editor          User?                              @relation("StoryMapConnectionPathEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([connectionId, mapId])
  @@index([mapId])
  @@index([connectionId])
}

/// Declares that a node features a bible entry, so a scene lists its cast and
/// the bible can show where a creature actually appears.
model StoryEntryLink {
  id        String     @id @default(uuid()) @db.Uuid
  nodeId    String     @db.Uuid
  entryId   String     @db.Uuid
  createdAt DateTime   @default(now())
  node      StoryNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  entry     StoryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([nodeId, entryId])
  @@index([entryId])
}

/// The change log every board and bible page reads from. It is also the review
/// trail: a promotion to CANON is a STATUS_CHANGED revision, so the reviewer is
/// recorded without every entity carrying its own reviewer columns.
model StoryRevision {
  id          String              @id @default(uuid()) @db.Uuid
  entityType  String              @db.VarChar(12)
  entityId    String              @db.Uuid
  arcId       String?             @db.Uuid
  action      StoryRevisionAction
  actorUserId String              @db.Uuid
  summary     String              @db.VarChar(300)
  before      Json?
  after       Json?
  createdAt   DateTime            @default(now())
  actor       User                @relation("StoryRevisionActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId, createdAt])
  @@index([arcId, createdAt])
  @@index([createdAt])
}

/// Discussion attached to exactly one node or bible entry — the migration CHECKs
/// that precisely one of the two targets is set.
model StoryComment {
  id               String      @id @default(uuid()) @db.Uuid
  nodeId           String?     @db.Uuid
  entryId          String?     @db.Uuid
  authorUserId     String      @db.Uuid
  body             String      @db.VarChar(2000)
  resolvedAt       DateTime?
  resolvedByUserId String?     @db.Uuid
  createdAt        DateTime    @default(now())
  node             StoryNode?  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  entry            StoryEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  author           User        @relation("StoryCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  resolver         User?       @relation("StoryCommentResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([nodeId, createdAt])
  @@index([entryId, createdAt])
}

/// Who is on which board right now. Freshness is judged from `lastSeenAt` at
/// read time rather than by deleting rows on exit, because a browser that dies
/// never sends its goodbye — the same reason the streaming showcase treats
/// absence, not an event, as the authoritative signal.
model StoryPresence {
  userId     String     @id @db.Uuid
  arcId      String?    @db.Uuid
  nodeId     String?    @db.Uuid
  lastSeenAt DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  arc        StoryArc?  @relation(fields: [arcId], references: [id], onDelete: Cascade)
  node       StoryNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([arcId, lastSeenAt])
}

/// One audited exchange with the codex assistant.
///
/// The question and the answer are stored verbatim. The extract the model was
/// shown is NOT copied here — it would duplicate most of the story on every
/// question — but `contextSummary` plus `revisionCursor` pin down exactly which
/// codex state was rendered, and that render is a pure function, so any
/// exchange can be reconstructed after the fact.
///
/// Rows are kept for outcomes where no request ever left the Habitat, because
/// a member repeatedly hitting the rate limit or the daily budget is precisely
/// what an audit should be able to see.
model StoryAssistantMessage {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @db.Uuid
  arcId          String?               @db.Uuid
  nodeId         String?               @db.Uuid
  question       String                @db.VarChar(2000)
  answer         String?               @db.Text
  outcome        StoryAssistantOutcome
  model          String                @db.VarChar(60)
  contextSummary String                @db.VarChar(500)
  /// The newest StoryRevision at the moment the extract was built.
  revisionCursor String?               @db.Uuid
  promptTokens   Int?
  responseTokens Int?
  /// Reasoning tokens. Billed, invisible in the reply, and typically the bulk
  /// of a short answer's cost on a thinking model.
  thinkingTokens Int?
  latencyMs      Int?
  failureReason  String?               @db.VarChar(300)
  createdAt      DateTime              @default(now())
  user           User                  @relation("StoryAssistantAsker", fields: [userId], references: [id], onDelete: Cascade)
  arc            StoryArc?             @relation(fields: [arcId], references: [id], onDelete: SetNull)
  node           StoryNode?            @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([arcId, createdAt])
  @@index([createdAt])
  @@index([outcome, createdAt])
}

/// A bearer token the Unreal machine reads the canon export with. Only the
/// SHA-256 hash is stored, so a leaked database row cannot be replayed against
/// the endpoint — the same handling the Steam and Twitch link nonces get.
model StoryExportToken {
  id              String    @id @default(uuid()) @db.Uuid
  label           String    @db.VarChar(80)
  tokenHash       String    @unique @db.VarChar(64)
  createdByUserId String    @db.Uuid
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  creator         User      @relation("StoryExportTokenCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([revokedAt])
}

/// A named, frozen, hash-locked cut of canon — the boundary between the
/// writers' room and everything downstream.
///
/// The room lands every save straight at CANON on purpose, which used to mean
/// the export endpoint and Codex Sync read a moving target. A release freezes
/// what canon was at one moment; downstream reads a release by name and
/// nothing outside the room shifts until somebody deliberately cuts again.
///
/// Immutable, and enforced by database triggers rather than convention — see
/// migration 20260828150000_add_story_releases. A release is withdrawn by
/// cutting a newer one, never by editing the row.
model StoryRelease {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Frozen identity, e.g. martino-2026.08.1. Never renamed.
  name            String   @unique @db.VarChar(80)
  notes           String?  @db.VarChar(500)
  /// The story export contract this payload satisfies.
  contractVersion Int
  /// The frozen MartinoStoryExport, exactly as the endpoint serves it.
  payload         Json
  /// sha256 over the stable serialisation of `payload` — what an importer pins.
  sha256          String   @unique @db.VarChar(64)
  bytes           Int
  /// The Atlas at cut time. Deliberately outside `contractVersion`: whether
  /// Atlas topology ships to the game is still open, and a release is a
  /// complete record of canon regardless of what the wire format carries.
  atlas           Json
  atlasSha256     String   @db.VarChar(64)
  counts          Json
  /// Proof the gate ran. A cut is refused unless the release audit passes with
  /// no waivers honoured.
  audit           Json
  cutAt           DateTime @default(now())
  cutByUserId     String   @db.Uuid
  cutBy           User     @relation("StoryReleaseCutBy", fields: [cutByUserId], references: [id], onDelete: Restrict)

  @@index([cutAt(sort: Desc)])
}

/// One spoken line inside a node: the addressable unit the voice pipeline
/// renders one WAV for and the game importer turns into one dialogue node.
/// Prose in `StoryNode.body` stays the reading surface; lines are the
/// structured record beside it (codex export contract v5, 2026-09-02).
///
/// `number` is the frozen export identity inside the node: the two digits at
/// the end of `<arcSlug>/<nodeKey>/<nn>`. It is minted once, never reused, and
/// never renumbered. Deleting a line retires its number (`retiredAt`), so an
/// asset built from `.../03` can never later mean a different sentence.
/// `order` is the display and playback order and moves freely.
///
/// Exactly one of `speakerEntryId` (a CHARACTER bible entry) and `speakerRole`
/// (a free role such as radio, stormglass-guard, player, unattributed) is set;
/// the migration CHECKs it. The listener may be either, or neither.
model StoryLine {
  id               String      @id @default(uuid()) @db.Uuid
  nodeId           String      @db.Uuid
  number           Int
  order            Int         @default(0)
  speakerEntryId   String?     @db.Uuid
  speakerRole      String?     @db.VarChar(64)
  listenerEntryId  String?     @db.Uuid
  listenerRole     String?     @db.VarChar(64)
  /// The exact spoken words: plain text, one utterance, no markdown, no
  /// [[slugs]], no stage direction, no line breaks (CHECKed).
  text             String      @db.VarChar(1000)
  /// Performance direction for the voice model, e.g. "tactical shout, not
  /// narration". Empty string when there is none.
  performance      String      @default("") @db.VarChar(200)
  /// 1 flat/bored .. 10 full battlefield.
  intensity        Int         @default(5)
  /// Lower-case tags from the fixed list in packages/shared (dialogue-lines).
  emotion          String[]    @default([])
  locale           String      @default("en-US") @db.VarChar(16)
  voiced           Boolean     @default(true)
  /// A retired line keeps its number and leaves the export.
  retiredAt        DateTime?
  createdByUserId  String      @db.Uuid
  updatedByUserId  String?     @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  node             StoryNode   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  speaker          StoryEntry? @relation("StoryLineSpeaker", fields: [speakerEntryId], references: [id], onDelete: Restrict)
  listener         StoryEntry? @relation("StoryLineListener", fields: [listenerEntryId], references: [id], onDelete: Restrict)
  creator          User        @relation("StoryLineCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  editor           User?       @relation("StoryLineEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([nodeId, number])
  @@index([nodeId, retiredAt, order])
  @@index([speakerEntryId])
}
