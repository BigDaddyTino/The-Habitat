/// Seasons are an optional, time-bounded goal layer. They never own or mutate
/// lifetime XP, achievements, records, titles, or their source evidence.
/// Migration 20260814230000 enforces a positive community goal and an exact
/// three-calendar-month window.
model Season {
  id                  String                  @id @default(uuid()) @db.Uuid
  slug                String                  @unique @db.VarChar(80)
  ordinal             Int                     @unique
  name                String                  @db.VarChar(100)
  description         String                  @db.VarChar(400)
  theme               String                  @db.VarChar(80)
  startsAt            DateTime
  endsAt              DateTime
  status              SeasonStatus            @default(UPCOMING)
  communityXpGoal     Int
  /// Season XP a member must personally bank inside the window to receive that
  /// season's commemorative trophies at closure. Zero means every enrolled
  /// member qualifies. Enrollment alone never earns the shelf.
  trophyXpRequirement Int                     @default(1500)
  isEnabled           Boolean                 @default(true)
  completedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  memberships         SeasonMembership[]
  xpEntries           SeasonXpEntry[]
  quests              SeasonQuestDefinition[]
  expeditions         SeasonExpedition[]
  trophies            SeasonTrophy[]
  chronicle           SeasonChronicle?

  @@index([isEnabled, status, startsAt])
  @@index([endsAt])
}

