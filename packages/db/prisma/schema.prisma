model User {
  id                             String                         @id @default(uuid()) @db.Uuid
  name                           String?
  username                       String?                        @unique
  displayName                    String?
  email                          String?                        @unique
  emailVerified                  DateTime?
  role                           Role                           @default(VIEWER)
  image                          String?
  bio                            String?                        @db.VarChar(500)
  avatarBorder                   String?                        @db.VarChar(64)
  profileLayout                  String?                        @db.VarChar(64)
  isActive                       Boolean                        @default(false)
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  accounts                       Account[]
  sessions                       Session[]
  playerIdentities               PlayerIdentity[]
  auditLogs                      AuditLog[]
  chronicleReactions             ChronicleReaction[]
  identityClaims                 PlayerIdentityClaim[]          @relation("IdentityClaimant")
  resolvedIdentityClaims         PlayerIdentityClaim[]          @relation("IdentityClaimResolver")
  identitiesGranted              IdentityOwnershipTransaction[] @relation("IdentityOwnershipTo")
  identitiesRevoked              IdentityOwnershipTransaction[] @relation("IdentityOwnershipFrom")
  ownershipDecisions             IdentityOwnershipTransaction[] @relation("IdentityOwnershipActor")
  titles                         UserTitle[]                    @relation("TitleOwner")
  awardedTitles                  UserTitle[]                    @relation("TitleAwarder")
  achievements                   PlayerAchievement[]
  recordHolders                  RecordHolder[]                 @relation("RecordHolderUser")
  recordHistory                  RecordHistory[]                @relation("RecordHistoryUser")
  wakeRequests                   WakeRequest[]                  @relation("WakeRequestRequester")
  resolvedWakeRequests           WakeRequest[]                  @relation("WakeRequestResolver")
  wakeVotes                      WakeVote[]
  pollsCreated                   ServerPoll[]                   @relation("PollCreator")
  pollVotes                      ServerPollVote[]
  serverCommands                 ServerCommand[]
  socialAccounts                 UserSocialAccount[]
  unlockedRewards                UserAchievementReward[]
  steamLinkNonces                SteamLinkNonce[]
  twitchLinkNonces               TwitchLinkNonce[]
  twitchChannel                  TwitchChannel?
  discordStreamSignal            DiscordStreamSignal?
  xpEntries                      UserXpEntry[]
  weeklyQuestProgress            UserWeeklyQuestProgress[]
  seasonMemberships              SeasonMembership[]
  seasonXpEntries                SeasonXpEntry[]
  seasonQuestProgress            UserSeasonQuestProgress[]
  seasonTrophies                 UserSeasonTrophy[]
  identityReconciliations        IdentityRewardReconciliation[]
  clubGameProfiles               ClubGameProfile[]
  gameActivities                 GameActivity[]
  invitationsSent                Invitation[]                   @relation("InvitationSender")
  memberPresence                 MemberPresence?
  memberReferralsSent            MemberReferral[]               @relation("MemberReferralInviter")
  memberReferralReceived         MemberReferral?                @relation("MemberReferralInvitee")
  storyArcs                      StoryArc[]                     @relation("StoryArcCreator")
  storyArcLocks                  StoryArc[]                     @relation("StoryArcLock")
  storyNodesCreated              StoryNode[]                    @relation("StoryNodeCreator")
  storyNodesUpdated              StoryNode[]                    @relation("StoryNodeEditor")
  storyNodeLocks                 StoryNode[]                    @relation("StoryNodeLock")
  storyEdges                     StoryEdge[]                    @relation("StoryEdgeCreator")
  storyLinesCreated              StoryLine[]                    @relation("StoryLineCreator")
  storyLinesUpdated              StoryLine[]                    @relation("StoryLineEditor")
  storyEntriesCreated            StoryEntry[]                   @relation("StoryEntryCreator")
  storyEntriesUpdated            StoryEntry[]                   @relation("StoryEntryEditor")
  storyEntryLocks                StoryEntry[]                   @relation("StoryEntryLock")
  storyContributions             StoryEntryContribution[]       @relation("StoryContributionAuthor")
  storyContributionsFiled        StoryEntryContribution[]       @relation("StoryContributionCreator")
  storyRevisions                 StoryRevision[]                @relation("StoryRevisionActor")
  storyComments                  StoryComment[]                 @relation("StoryCommentAuthor")
  storyCommentsResolved          StoryComment[]                 @relation("StoryCommentResolver")
  storyPresence                  StoryPresence?
  storyExportTokens              StoryExportToken[]             @relation("StoryExportTokenCreator")
  storyReleases                  StoryRelease[]                 @relation("StoryReleaseCutBy")
  storyAssistantMessages         StoryAssistantMessage[]        @relation("StoryAssistantAsker")
  storyMapsCreated               StoryMap[]                     @relation("StoryMapCreator")
  storyMapsUpdated               StoryMap[]                     @relation("StoryMapEditor")
  storyMapPlacementsCreated      StoryMapPlacement[]            @relation("StoryMapPlacementCreator")
  storyMapPlacementsUpdated      StoryMapPlacement[]            @relation("StoryMapPlacementEditor")
  storyMapNodePlacementsCreated  StoryMapNodePlacement[]        @relation("StoryMapNodePlacementCreator")
  storyMapNodePlacementsUpdated  StoryMapNodePlacement[]        @relation("StoryMapNodePlacementEditor")
  storyMapTopologyNodesCreated   StoryMapTopologyNode[]         @relation("StoryMapTopologyNodeCreator")
  storyMapTopologyNodesUpdated   StoryMapTopologyNode[]         @relation("StoryMapTopologyNodeEditor")
  storyMapBoundariesCreated      StoryMapBoundary[]             @relation("StoryMapBoundaryCreator")
  storyMapBoundariesUpdated      StoryMapBoundary[]             @relation("StoryMapBoundaryEditor")
  storyMapAreaRingsCreated       StoryMapAreaRing[]             @relation("StoryMapAreaRingCreator")
  storyMapAreaRingsUpdated       StoryMapAreaRing[]             @relation("StoryMapAreaRingEditor")
  storyWorldConnectionsCreated   StoryWorldConnection[]         @relation("StoryWorldConnectionCreator")
  storyWorldConnectionsUpdated   StoryWorldConnection[]         @relation("StoryWorldConnectionEditor")
  storyMapConnectionPathsCreated StoryMapConnectionPath[]       @relation("StoryMapConnectionPathCreator")
  storyMapConnectionPathsUpdated StoryMapConnectionPath[]       @relation("StoryMapConnectionPathEditor")
