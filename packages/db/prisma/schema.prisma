  REVOKE
}

enum IdentityOwnershipStatus {
  APPLIED
  REVERSED
}

/// How an ownership change was authorised. Only `ADMIN_CLAIM_APPROVAL`,
/// `ADMIN_TRANSFER`, and `ADMIN_REVOCATION` involve a human decision; the two
/// automatic sources are provider proof and carry no reviewer.
enum IdentityOwnershipSource {
  ADMIN_CLAIM_APPROVAL
  ADMIN_TRANSFER
  ADMIN_REVOCATION
  STEAM_VERIFICATION
  WORKER_AUTO_LINK
}

enum UserTitleSource {
  ADMIN
  ACHIEVEMENT
}

enum AchievementRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  QUESTIONABLE_LIFE_CHOICE
}

enum AchievementRuleType {
  EVENT_COUNT
  GAME_EVENT_COUNT
  DISTINCT_GAME_EVENT_COUNT
  LEGACY_EVIDENCE_COUNT
  LEVEL_REACHED
  WEB_INTERACTION
  ACTIVITY_COUNT
  ACTIVITY_VALUE_SUM
  DISTINCT_ACTIVITY_GAME_COUNT
  ORDERED_ACTIVITY_STREAK
  SHARED_ACTIVITY_COUNT
  ACTIVITY_STAT_THRESHOLD
}

enum LegacyEvidenceKind {
  PARTICIPATION
  SESSION
}

enum XpSource {
  VERIFIED_PLAYTIME
  WEEKLY_QUEST
}

enum WeeklyQuestRuleType {
  PLAY_SECONDS
  JOIN_COUNT
  DISTINCT_GAME_COUNT
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum SeasonRuleType {
  PLAY_SECONDS
  JOIN_COUNT
  DISTINCT_GAME_COUNT
  BOSS_KILL_COUNT
}

enum SeasonQuestScope {
  PERSONAL
  TEAM
}

enum SeasonXpSource {
  VERIFIED_PLAYTIME
  PERSONAL_QUEST
  TEAM_QUEST
}

enum SeasonTrophyKind {
  COMMEMORATIVE
  FOUNDING_MEMBER
}

enum AchievementRewardKind {
  TITLE
  AVATAR_BORDER
  PROFILE_LAYOUT
  BADGE
  MEDAL
  TROPHY
}

enum SocialPlatform {
  TWITCH
  STEAM
  DISCORD
  YOUTUBE
  XBOX
  PLAYSTATION
  EPIC_GAMES
  BATTLE_NET
  RIOT_GAMES
  GITHUB
}

enum RecordHall {
  LEGENDS
  SHAME
}

enum RecordRuleType {
  PLAYER_EVENT_COUNT
  DISTINCT_GAME_EVENT_COUNT
  ACHIEVEMENT_COUNT
  ACTIVITY_COUNT
  ACTIVITY_VALUE_SUM
  ACTIVITY_DISTINCT_GAME_COUNT
}

enum RecordComparison {
  MAX
  MIN
}

enum DiscordNotificationKind {
  SERVER_ONLINE
  SERVER_SLEEPING
  SERVER_OUTAGE
  RECORD_BROKEN
  LEGENDARY_ACHIEVEMENT
  BOSS_KILLED
  WORLD_GATHERING
  WAKE_REQUEST
  WEEKLY_CHRONICLE
  STREAM_WENT_LIVE
  /// Operational health, never community news. Delivered only to a guild's
  /// explicitly configured operations channel, never the announcement channel.
  OPERATIONS_ALERT
}

/// How a Discord streaming signal was observed. Discord presence is a hint that
/// a member is broadcasting, never proof of what they are broadcasting, so it is
/// recorded separately from the authoritative Twitch live state.
enum DiscordStreamKind {
  /// A "Streaming" presence activity, which carries a self-reported channel URL.
  PRESENCE_ACTIVITY
  /// Go Live screen sharing inside a Habitat voice channel.
  VOICE_GO_LIVE
}

enum WakeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ServerPollStatus {
  ACTIVE
  CLOSED
}

enum ServerCommandAction {
  START
  STOP
  RESTART
  UPDATE
}

enum ServerCommandStatus {
  REQUESTED
  AUTHORIZED
  DISPATCHED
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
}

/// The three long-running Habitat processes that report a heartbeat.
enum HabitatService {
  WEB
  WORKER
  AGENT
}

/// UNKNOWN is deliberately its own state rather than a flavour of failure: a
/// signal nobody has been able to evaluate must never be painted green, and
/// must never be alerted on as though it were a confirmed outage.
enum PulseStatus {
  OK
  WARN
  CRITICAL
  UNKNOWN
}

enum PulseCategory {
  DELIVERY
  SERVICES
  COLLECTION
  DATA
  PROVIDERS
  PIPELINE
}

model User {
  id                     String                    @id @default(uuid()) @db.Uuid
  name                   String?
  username               String?                   @unique
  displayName            String?
  email                  String?                   @unique
  emailVerified          DateTime?
  role                   Role                      @default(VIEWER)
  image                  String?
  bio                    String?                   @db.VarChar(500)
  avatarBorder           String?                   @db.VarChar(64)
  profileLayout          String?                   @db.VarChar(64)
  isActive               Boolean                   @default(false)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  accounts               Account[]
  sessions               Session[]
  playerIdentities       PlayerIdentity[]
  auditLogs              AuditLog[]
  chronicleReactions     ChronicleReaction[]
  identityClaims         PlayerIdentityClaim[]     @relation("IdentityClaimant")
  resolvedIdentityClaims PlayerIdentityClaim[]     @relation("IdentityClaimResolver")
  identitiesGranted      IdentityOwnershipTransaction[] @relation("IdentityOwnershipTo")
  identitiesRevoked      IdentityOwnershipTransaction[] @relation("IdentityOwnershipFrom")
  ownershipDecisions     IdentityOwnershipTransaction[] @relation("IdentityOwnershipActor")
  titles                 UserTitle[]               @relation("TitleOwner")
  awardedTitles          UserTitle[]               @relation("TitleAwarder")
  achievements           PlayerAchievement[]
  recordHolders          RecordHolder[]            @relation("RecordHolderUser")
  recordHistory          RecordHistory[]           @relation("RecordHistoryUser")
  wakeRequests           WakeRequest[]             @relation("WakeRequestRequester")
  resolvedWakeRequests   WakeRequest[]             @relation("WakeRequestResolver")
  wakeVotes              WakeVote[]
  pollsCreated           ServerPoll[]              @relation("PollCreator")
  pollVotes              ServerPollVote[]
  serverCommands         ServerCommand[]
  socialAccounts         UserSocialAccount[]
  unlockedRewards        UserAchievementReward[]
  steamLinkNonces        SteamLinkNonce[]
  twitchLinkNonces       TwitchLinkNonce[]
  twitchChannel          TwitchChannel?
  discordStreamSignal    DiscordStreamSignal?
  xpEntries              UserXpEntry[]
  weeklyQuestProgress    UserWeeklyQuestProgress[]
  seasonMemberships      SeasonMembership[]
  seasonXpEntries        SeasonXpEntry[]
  seasonQuestProgress    UserSeasonQuestProgress[]
  seasonTrophies         UserSeasonTrophy[]
  identityReconciliations IdentityRewardReconciliation[]
  clubGameProfiles        ClubGameProfile[]
  gameActivities          GameActivity[]
  invitationsSent         Invitation[]                @relation("InvitationSender")
  memberPresence          MemberPresence?
  memberReferralsSent     MemberReferral[]           @relation("MemberReferralInviter")
  memberReferralReceived  MemberReferral?             @relation("MemberReferralInvitee")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  role            Role      @default(USER)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  invitedByUserId String?   @db.Uuid
  invitedBy       User?     @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  memberReferral  MemberReferral?

  @@index([invitedByUserId, createdAt])
  @@index([revokedAt, expiresAt])
}

model MemberReferral {
  id             String      @id @default(uuid()) @db.Uuid
  inviterUserId  String      @db.Uuid
  invitedUserId  String      @unique @db.Uuid
  invitationId   String?     @unique @db.Uuid
  method         String      @db.VarChar(16)
  codeWeek       String?     @db.VarChar(10)
  createdAt      DateTime    @default(now())
  inviter        User        @relation("MemberReferralInviter", fields: [inviterUserId], references: [id], onDelete: Restrict)
  invitedUser    User        @relation("MemberReferralInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitation     Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([inviterUserId, createdAt])
  @@index([method, createdAt])
}

model MemberPresence {
  userId       String   @id @db.Uuid
  authProvider String   @default("Discord") @db.VarChar(32)
  deviceType   String   @db.VarChar(32)
  platform     String   @db.VarChar(64)
  browser      String   @db.VarChar(64)
  lastSeenAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastSeenAt])
}

model GameServer {
  id                   String                 @id @default(uuid()) @db.Uuid
  slug                 String                 @unique
  displayName          String
  gameType             GameType
  worldName            String
  description          String?
  enabled              Boolean                @default(true)
  controlEnabled       Boolean                @default(false)
  desiredState         ServerState            @default(SLEEPING)
  actualState          ServerState            @default(UNKNOWN)
  lastStateChangeAt    DateTime?
  lastQueryAt          DateTime?
  lastOnlineAt         DateTime?
  currentVersion       String?
  currentBuildId       String?
  maxPlayers           Int?
  adapterType          String
  capabilities         Json
  publicNotes          String?
  adminNotes           String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  runtimeState         ServerRuntimeState?
  statusHistory        ServerStatusHistory[]
  metricSamples        ServerMetricSample[]
  events               ServerEvent[]
  playerIdentities     PlayerIdentity[]
  playerPresence       ServerPlayerPresence[]
  legacyPlayerEvidence LegacyPlayerEvidence[]
  wakeRequests         WakeRequest[]
  pollOptions          ServerPollOption[]
  commands             ServerCommand[]
  collectorSources     CollectorSourceState[]
}

model ServerRuntimeState {
  id               String      @id @default(uuid()) @db.Uuid
  serverId         String      @unique @db.Uuid
  state            ServerState @default(UNKNOWN)
  reachable        Boolean?
  playerCount      Int?
  maxPlayers       Int?
  pingMs           Int?
  version          String?
  buildId          String?
  processRunning   Boolean?
  processStartedAt DateTime?
  observedAt       DateTime    @default(now())
  details          Json?
  server           GameServer  @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model ServerStatusHistory {
  id           String       @id @default(uuid()) @db.Uuid
  serverId     String       @db.Uuid
  state        ServerState
  desiredState ServerState?
  observedAt   DateTime     @default(now())
  reason       String?
  details      Json?
  server       GameServer   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, observedAt])
}

model ServerMetricSample {
  id                 String     @id @default(uuid()) @db.Uuid
  serverId           String     @db.Uuid
  observedAt         DateTime
  playerCount        Int?
  maxPlayers         Int?
  pingMs             Int?
  processMemoryBytes BigInt?
  cpuSeconds         Float?
  diskFreeBytes      BigInt?
  diskTotalBytes     BigInt?
  source             String
  server             GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, observedAt])
}

model PlayerIdentity {
  id                String                 @id @default(uuid()) @db.Uuid
  userId            String?                @db.Uuid
  serverId          String?                @db.Uuid
  gameType          GameType
  displayName       String
  providerKey       String
  externalProvider  SocialPlatform?
  externalAccountId String?                @db.VarChar(80)
  verifiedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  server            GameServer?            @relation(fields: [serverId], references: [id], onDelete: SetNull)
  events            ServerEvent[]
  claims            PlayerIdentityClaim[]
  recordHolders     RecordHolder[]
  recordHistory     RecordHistory[]
  legacyEvidence    LegacyPlayerEvidence[]
  reconciliation    IdentityRewardReconciliation?
  ownershipLedger   IdentityOwnershipTransaction[]

  @@unique([gameType, providerKey])
  @@index([externalProvider, externalAccountId])
}

model PlayerIdentityClaim {
  id               String              @id @default(uuid()) @db.Uuid
  playerIdentityId String              @db.Uuid
  userId           String              @db.Uuid
  status           IdentityClaimStatus @default(PENDING)
  requestedAt      DateTime            @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?             @db.Uuid
  resolutionNote   String?
  playerIdentity   PlayerIdentity      @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)
  user             User                @relation("IdentityClaimant", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy       User?               @relation("IdentityClaimResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  ownershipLedger  IdentityOwnershipTransaction[]

  @@unique([playerIdentityId, userId])
  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}

model IdentityRewardReconciliation {
  id               String          @id @default(uuid()) @db.Uuid
  playerIdentityId String          @unique @db.Uuid
  userId           String          @db.Uuid
  queuedAt         DateTime        @default(now())
  completedAt      DateTime?
  attempts         Int             @default(0)
  lastError        String?         @db.VarChar(180)
  playerIdentity   PlayerIdentity  @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([completedAt, queuedAt])
  @@index([userId, completedAt])
}

/// Append-only ownership ledger for `PlayerIdentity`. Every transition of
/// `PlayerIdentity.userId` — granted by claim approval, by Steam proof, by the
/// worker's auto-link, or revoked by an administrator — writes exactly one row
/// here, inside the same transaction as the change itself.
///
/// This is what makes a claim reversible. `projectedImpact` stores the preview
/// an administrator was shown before confirming, and `appliedImpact` stores
/// what the reversal actually removed, so the two can be compared afterwards.
/// A REVOKE points at the GRANT it reverses through `reversalTransactionId`;
/// that GRANT is marked `REVERSED` in the same database transaction.
///
/// Database-enforced in migration 20260814120000 and NOT expressible here:
/// CHECK "IdentityOwnershipTransaction_direction" — a GRANT must carry a
/// `toUserId` and a REVOKE must carry a `fromUserId`.
model IdentityOwnershipTransaction {
  id                    String                        @id @default(uuid()) @db.Uuid
  playerIdentityId      String                        @db.Uuid
  action                IdentityOwnershipAction
  status                IdentityOwnershipStatus       @default(APPLIED)
  source                IdentityOwnershipSource
  fromUserId            String?                       @db.Uuid
  toUserId              String?                       @db.Uuid
  claimId               String?                       @db.Uuid
  actorUserId           String?                       @db.Uuid
  reason                String?                       @db.VarChar(300)
  projectedImpact       Json?
  appliedImpact         Json?
  reversalTransactionId String?                       @unique @db.Uuid
  reversedAt            DateTime?
  createdAt             DateTime                      @default(now())
  playerIdentity        PlayerIdentity                @relation(fields: [playerIdentityId], references: [id], onDelete: Restrict)
  fromUser              User?                         @relation("IdentityOwnershipFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser                User?                         @relation("IdentityOwnershipTo", fields: [toUserId], references: [id], onDelete: SetNull)
  actor                 User?                         @relation("IdentityOwnershipActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  claim                 PlayerIdentityClaim?          @relation(fields: [claimId], references: [id], onDelete: SetNull)
  reversalOf            IdentityOwnershipTransaction? @relation("IdentityOwnershipReversal", fields: [reversalTransactionId], references: [id], onDelete: SetNull)
  reversedBy            IdentityOwnershipTransaction? @relation("IdentityOwnershipReversal")

  @@index([playerIdentityId, createdAt])
  @@index([toUserId, createdAt])
  @@index([fromUserId, createdAt])
  @@index([action, status, createdAt])
}

model LegacyPlayerEvidence {
  id               String             @id @default(uuid()) @db.Uuid
  serverId         String             @db.Uuid
  playerIdentityId String             @db.Uuid
  gameType         GameType
  kind             LegacyEvidenceKind
  occurredAt       DateTime
  endedAt          DateTime?
  durationSeconds  Int?
  sourceKind       String             @db.VarChar(40)
  sourceLabel      String             @db.VarChar(80)
  sourceRecordHash String             @db.VarChar(64)
  importedAt       DateTime           @default(now())
  dedupeKey        String             @unique @db.VarChar(220)
  server           GameServer         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  playerIdentity   PlayerIdentity     @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)

  @@index([serverId, occurredAt])
  @@index([playerIdentityId, occurredAt])
  @@index([kind, occurredAt])
}

/// Hand-written SQL constraint (migration 20260811183000_add_progression_constraints):
/// CHECK "UserXpEntry_amount_positive" ("amount" > 0).
/// It exists only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop it.
model UserXpEntry {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  serverEventId String?      @db.Uuid
  source        XpSource
  amount        Int
  description   String       @db.VarChar(160)
  earnedAt      DateTime     @default(now())
  dedupeKey     String       @unique @db.VarChar(220)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverEvent   ServerEvent? @relation(fields: [serverEventId], references: [id], onDelete: SetNull)

  @@index([userId, earnedAt])
  @@index([source, earnedAt])
}

/// Hand-written SQL constraints (migration 20260811183000_add_progression_constraints):
/// CHECK "WeeklyQuestDefinition_threshold_positive" ("threshold" > 0) and
/// CHECK "WeeklyQuestDefinition_xpReward_positive" ("xpReward" > 0).
/// They exist only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop them.
model WeeklyQuestDefinition {
  id          String                 @id @default(uuid()) @db.Uuid
  slug        String                 @unique @db.VarChar(80)
  name        String                 @db.VarChar(100)
  description String                 @db.VarChar(240)
  ruleType    WeeklyQuestRuleType
  threshold   Int
  xpReward    Int
  icon        String?                @db.VarChar(40)
  enabled     Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  selections  WeeklyQuestSelection[]
}

/// Hand-written SQL constraint (migration 20260811183000_add_progression_constraints):
/// CHECK "WeeklyQuestCycle_valid_window" ("endsAt" > "weekStart").
/// It exists only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop it.
model WeeklyQuestCycle {
  id         String                 @id @default(uuid()) @db.Uuid
  weekStart  DateTime               @unique
  endsAt     DateTime
  createdAt  DateTime               @default(now())
  selections WeeklyQuestSelection[]
}

/// Hand-written SQL constraint (migration 20260811183000_add_progression_constraints):
/// CHECK "WeeklyQuestSelection_sortOrder_valid" ("sortOrder" >= 0 AND "sortOrder" < 16).
/// It exists only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop it.
model WeeklyQuestSelection {
  id           String                    @id @default(uuid()) @db.Uuid
  cycleId      String                    @db.Uuid
  definitionId String                    @db.Uuid
  sortOrder    Int
  cycle        WeeklyQuestCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  definition   WeeklyQuestDefinition     @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  progress     UserWeeklyQuestProgress[]

  @@unique([cycleId, definitionId])
  @@index([cycleId, sortOrder])
}

/// Hand-written SQL constraint (migration 20260811183000_add_progression_constraints):
/// CHECK "UserWeeklyQuestProgress_nonnegative" ("progress" >= 0).
/// It exists only in the migration SQL, not in this schema — `prisma migrate dev` can silently drop it.
model UserWeeklyQuestProgress {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  selectionId String               @db.Uuid
  progress    Int                  @default(0)
  completedAt DateTime?
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  selection   WeeklyQuestSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@unique([userId, selectionId])
  @@index([userId, completedAt])
}

/// Seasons are an optional, time-bounded goal layer. They never own or mutate
/// lifetime XP, achievements, records, titles, or their source evidence.
/// Migration 20260814230000 enforces a positive community goal and an exact
/// three-calendar-month window.
model Season {
  id                String                    @id @default(uuid()) @db.Uuid
  slug              String                    @unique @db.VarChar(80)
  ordinal           Int                       @unique
  name              String                    @db.VarChar(100)
  description       String                    @db.VarChar(400)
  theme             String                    @db.VarChar(80)
  startsAt          DateTime
  endsAt            DateTime
  status            SeasonStatus              @default(UPCOMING)
  communityXpGoal   Int
  isEnabled         Boolean                   @default(true)
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  memberships       SeasonMembership[]
  xpEntries         SeasonXpEntry[]
  quests            SeasonQuestDefinition[]
  expeditions       SeasonExpedition[]
  trophies          SeasonTrophy[]
  chronicle         SeasonChronicle?

  @@index([isEnabled, status, startsAt])
  @@index([endsAt])
}

model SeasonMembership {
  id        String   @id @default(uuid()) @db.Uuid
  seasonId String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now())
  season   Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([userId, joinedAt])
}

model SeasonQuestDefinition {
  id               String                      @id @default(uuid()) @db.Uuid
  seasonId         String                      @db.Uuid
  slug             String                      @db.VarChar(80)
  name             String                      @db.VarChar(100)
  description      String                      @db.VarChar(240)
  scope            SeasonQuestScope
  gameType         GameType?
  ruleType         SeasonRuleType
  threshold        Int
  xpReward         Int
  sortOrder        Int                         @default(0)
  enabled          Boolean                     @default(true)
  season           Season                      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  personalProgress UserSeasonQuestProgress[]
  teamProgress     SeasonTeamQuestProgress?

  @@unique([seasonId, slug])
  @@index([seasonId, scope, sortOrder])
}

model UserSeasonQuestProgress {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  questId     String                @db.Uuid
  progress    Int                   @default(0)
  completedAt DateTime?
