  displayPublic  Boolean               @default(false)
  /// Occupying a squad seat is a separate, explicit choice from sharing stats.
  /// NULL means the member holds no seat; a seat is never assigned automatically.
  rosterSeatClaimedAt DateTime?
  connectedAt    DateTime              @default(now())
  lastSyncedAt   DateTime?
  lastAttemptedAt DateTime?
  nextAttemptAt  DateTime?
  consecutiveFailures Int               @default(0)
  syncStatus     ClubProfileSyncStatus @default(READY)
  syncError      String?               @db.VarChar(180)
  playerLevel    Int?
  rankName       String?               @db.VarChar(40)
  peakRankName   String?               @db.VarChar(40)
  rankScore      Int?
  /// Best rating the provider has ever reported, across all seasons.
  peakRankScore  Int?
  /// Competitive wins summed from per-season records. These survive even when a
  /// provider holds no career overview, so they are stored separately from
  /// totalWins rather than being merged into it.
  rankedWins     Int?
  rankedSeasons  Int?
  totalMatches   Int?
  totalWins      Int?
  overallKd      Float?
  overallKda     Float?
  topHeroes      Json?
  providerUpdatedAt DateTime?
  matchStatus              ProviderSyncStatus @default(PENDING)
  matchLastAttemptedAt     DateTime?
  matchLastSuccessfulAt    DateTime?
  matchNextAttemptAt       DateTime?
  matchConsecutiveFailures Int                @default(0)
  matchSyncError           String?            @db.VarChar(180)
  matchCursorOccurredAt    DateTime?
  matchCursorProviderId    String?            @db.VarChar(80)
  matchHistoryGapDetected  Boolean            @default(false)
  steamLastPlayingAt       DateTime?
  steamPresenceCheckedAt   DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots      ClubGameStatSnapshot[]
  matchParticipants ClubGameMatchParticipant[]

  @@unique([userId, gameType])
  @@unique([gameType, providerUid])
  @@index([gameType, rankScore])
  @@index([gameType, lastSyncedAt])
  @@index([gameType, nextAttemptAt])
  @@index([gameType, matchNextAttemptAt])
  @@index([gameType, rosterSeatClaimedAt])
}

